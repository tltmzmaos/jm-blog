---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { shouldShowDrafts } from '../utils/env';
import { SITE_DESCRIPTION, SITE_TITLE } from '../utils/site';

const showDrafts = shouldShowDrafts();
const posts = (await getCollection('blog'))
  .filter((post) => showDrafts || !post.data.draft)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
  }));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Header />

  <main class="container home" id="main-content">
    <!-- The header already shows the name; the page opens on what it's about. -->
    <h1 class="sr-only">{SITE_TITLE}</h1>
    <p class="intro">{SITE_DESCRIPTION}</p>

    <PostList posts={posts} />

    {posts.length === 0 && <p class="empty">No posts yet.</p>}
  </main>
</BaseLayout>

<style>
  .home {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .intro {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0 0 2.75rem;
  }

  .empty {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .home {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }

    .intro {
      margin-bottom: 2.25rem;
    }
  }
</style>
