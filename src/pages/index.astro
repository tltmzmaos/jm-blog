---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PostListItem from '../components/PostListItem.astro';
import { shouldShowDrafts } from '../utils/env';
import { getEntryNumbers, newestFirst } from '../utils/entryNumbers';
import { SITE_DESCRIPTION, SITE_TITLE } from '../utils/site';
import { assertUniqueTransitionNames } from '../utils/viewTransition';

const showDrafts = shouldShowDrafts();
const entries = await getEntryNumbers();
const posts = (await getCollection('blog'))
  .filter((post) => showDrafts || !post.data.draft)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    entry: entries.get(post.id),
  }))
  .sort(newestFirst);

// Each title morphs into its post's heading by a name made from its slug.
assertUniqueTransitionNames(posts.map((p) => p.slug));

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Header />

  <main class="container home" id="main-content">
    <div class="intro">
      <h1 class="name">{SITE_TITLE}</h1>
      <p class="lead">{SITE_DESCRIPTION}</p>
    </div>

    {
      posts.length > 0 ? (
        <section aria-labelledby="posts-title">
          <h2 class="sr-only" id="posts-title">
            Posts
          </h2>
          <ul class="rows" role="list">
            {posts.map((post) => (
              <li>
                <PostListItem {...post} withYear />
              </li>
            ))}
          </ul>
          <p class="archive">
            <a href={`${baseUrl}posts/`} class="text-link">
              Archive by year <span aria-hidden="true">→</span>
            </a>
          </p>
        </section>
      ) : (
        <p class="empty">No posts yet.</p>
      )
    }
  </main>
</BaseLayout>

<style>
  .home {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  /* The name and what the notes are about, kept short so the posts start
     high on the first screen. */
  .intro {
    margin: 0 0 2.5rem;
  }

  .name {
    font-size: 1.875rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
  }

  .lead {
    font-size: 1.0625rem;
    text-wrap: balance;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0.375rem 0 0;
  }

  /* Hairlines between posts, so each row reads as its own item. */
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .rows > li {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .archive {
    margin: 2.5rem 0 0;
    font-size: 0.9375rem;
  }

  .empty {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .home {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }

    .intro {
      margin-bottom: 2rem;
    }

    .name {
      font-size: 1.625rem;
    }

    .lead {
      font-size: 1rem;
    }

    .rows > li {
      padding: 1rem 0;
    }
  }
</style>
