---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PostListItem from '../components/PostListItem.astro';
import SeriesStrip from '../components/SeriesStrip.astro';
import Timeline from '../components/Timeline.astro';
import { shouldShowDrafts } from '../utils/env';
import { getEntryNumbers, newestFirst } from '../utils/entryNumbers';
import { getAllSeries } from '../utils/seriesIndex';
import { resolveShelves } from '../utils/shelves';
import { buildTimeline } from '../utils/timeline';
import { SITE_DESCRIPTION, SITE_TITLE } from '../utils/site';
import { assertUniqueTransitionNames } from '../utils/viewTransition';

// How many of the newest posts open the page.
const RECENT_COUNT = 3;

const showDrafts = shouldShowDrafts();
const entries = await getEntryNumbers();
const posts = (await getCollection('blog'))
  .filter((post) => showDrafts || !post.data.draft)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    tags: post.data.tags,
    entry: entries.get(post.id),
  }))
  .sort(newestFirst);

const recent = posts.slice(0, RECENT_COUNT);
const shelves = resolveShelves(posts, await getAllSeries());
const timeline = buildTimeline(shelves, entries, new Date());

// A post can be both recent and on a shelf. Its title morphs into the post
// from the Recent row; the shelf row carries no name.
const inRecent = new Set(recent.map((p) => p.slug));
assertUniqueTransitionNames([
  ...recent.map((p) => p.slug),
  ...shelves.flatMap((s) =>
    s.kind === 'posts'
      ? s.posts.filter((p) => !inRecent.has(p.slug)).map((p) => p.slug)
      : []
  ),
]);

const anchor = (title: string) =>
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Header />

  <main class="container home" id="main-content">
    <div class="intro">
      <h1 class="name">{SITE_TITLE}</h1>
      <p class="lead">{SITE_DESCRIPTION}</p>
    </div>

    {
      posts.length > 0 && (
        <div class="map">
          <Timeline timeline={timeline} />
        </div>
      )
    }

    {
      recent.length > 0 && (
        <section class="section" aria-labelledby="recent">
          <h2 class="section-title" id="recent">
            Recent
          </h2>
          <ul class="rows" role="list">
            {recent.map((post) => (
              <li>
                <PostListItem {...post} withYear />
              </li>
            ))}
          </ul>
          <p class="all">
            <a href={`${baseUrl}posts/`} class="text-link">
              All posts <span aria-hidden="true">→</span>
            </a>
          </p>
        </section>
      )
    }

    {
      shelves.map((shelf) => (
        <section
          class="section"
          id={anchor(shelf.title)}
          aria-labelledby={`${anchor(shelf.title)}-title`}
        >
          <h2 class="section-title" id={`${anchor(shelf.title)}-title`}>
            {shelf.kind === 'series' ? (
              <a href={`${baseUrl}series/#${shelf.series.dir}`}>
                {shelf.title}
              </a>
            ) : (
              shelf.title
            )}
          </h2>
          <p class="shelf-desc">{shelf.description}</p>

          {shelf.kind === 'series' ? (
            <div class="series">
              <SeriesStrip name={shelf.series.title} parts={shelf.parts} />
              <p class="series-meta">
                {shelf.series.count}{' '}
                {shelf.series.count === 1 ? 'part' : 'parts'}
                <span aria-hidden="true"> · </span>
                {shelf.series.status === 'complete' ? 'Complete' : 'Ongoing'}
              </p>
            </div>
          ) : (
            <ul class="rows compact" role="list">
              {shelf.posts.map((post) => (
                <li>
                  <PostListItem
                    {...post}
                    withYear
                    compact
                    morph={!inRecent.has(post.slug)}
                  />
                </li>
              ))}
            </ul>
          )}
        </section>
      ))
    }

    {posts.length === 0 && <p class="empty">No posts yet.</p>}
  </main>
</BaseLayout>

<style>
  .home {
    padding-top: 3.5rem;
    padding-bottom: 4rem;
  }

  /* The one large thing on the site: the name, set tight, and what the
     notes are about under it. */
  .intro {
    margin: 0 0 2.5rem;
  }

  /* Plex at 90% width: a little narrower and taller in feel than the
     text around it, still the same family and weight as every title. */
  .name {
    font-size: 3rem;
    font-weight: 600;
    font-stretch: 90%;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-text);
    margin: 0;
  }

  .map {
    margin: 0 0 3.5rem;
  }

  .lead {
    font-size: 1.0625rem;
    text-wrap: balance;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0.875rem 0 0;
  }

  /* The newest posts, then one shelf per topic: what I'm working on and
     studying, read by subject rather than by date. */
  .section + .section {
    margin-top: 3rem;
  }

  .section-title {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  .section-title a {
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .section-title a:hover {
    text-decoration-line: underline;
  }

  .shelf-desc {
    text-wrap: pretty;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: -0.875rem 0 1.125rem;
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .rows.compact {
    gap: 0.625rem;
  }

  .all {
    margin: 1.5rem 0 0;
    font-size: 0.9375rem;
  }

  .series {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 1rem;
    row-gap: 0.25rem;
  }

  .series :global(.strip) {
    flex: 0 1 auto;
    min-width: 0;
  }

  .series-meta {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .empty {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .home {
      padding-top: 2.25rem;
      padding-bottom: 3rem;
    }

    .intro {
      margin-bottom: 2.5rem;
    }

    .name {
      font-size: 2.375rem;
    }

    .lead {
      font-size: 1rem;
    }

    .section + .section {
      margin-top: 2.5rem;
    }
  }
</style>
