---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { shouldShowDrafts } from '../utils/env';
import { SITE_DESCRIPTION, SITE_TITLE } from '../utils/site';

const showDrafts = shouldShowDrafts();
const posts = (await getCollection('blog'))
  .filter((post) => showDrafts || !post.data.draft)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
  }));
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <Header />

  <main class="container home" id="main-content">
    <div class="intro">
      <h1 class="name">{SITE_TITLE}</h1>
      <p class="lead">{SITE_DESCRIPTION}</p>
    </div>

    <PostList posts={posts} hangingYears />

    {posts.length === 0 && <p class="empty">No posts yet.</p>}
  </main>
</BaseLayout>

<style>
  .home {
    padding-top: 3.5rem;
    padding-bottom: 4rem;
  }

  /* The one large thing on the site: the name, set tight, and what the
     notes are about under it. */
  .intro {
    margin: 0 0 3.5rem;
  }

  .name {
    font-size: 3rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
    color: var(--color-text);
    margin: 0;
  }

  .lead {
    font-size: 1.0625rem;
    text-wrap: balance;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0.875rem 0 0;
  }

  .empty {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .home {
      padding-top: 2.25rem;
      padding-bottom: 3rem;
    }

    .intro {
      margin-bottom: 2.5rem;
    }

    .name {
      font-size: 2.375rem;
    }

    .lead {
      font-size: 1rem;
    }
  }
</style>
