---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { shouldShowDrafts } from '../../utils/env';
import { tagSlug } from '../../utils/tags';

const showDrafts = shouldShowDrafts();
const publishedPosts = (await getCollection('blog')).filter(
  (post) => showDrafts || !post.data.draft
);

const counts = new Map<string, number>();
for (const post of publishedPosts) {
  for (const tag of post.data.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
  }
}

// Most used first, then alphabetical.
const tags = [...counts]
  .sort(([a, ac], [b, bc]) => bc - ac || a.localeCompare(b))
  .map(([tag, count]) => ({ tag, count }));

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Tags — Jongmin Lee"
  description="Topics that come up most often in my writing, sorted by post count."
>
  <Header />

  <main class="container page" id="main-content">
    <h1 class="page-title">Tags</h1>
    <p class="page-lead">
      {tags.length} topics, most used first.
    </p>

    <div class="filter">
      <label for="tag-search" class="sr-only">Filter tags</label>
      <input
        type="search"
        id="tag-search"
        placeholder="Filter tags"
        autocomplete="off"
        spellcheck="false"
      />
    </div>

    <ul class="tag-list" id="tag-list" role="list">
      {
        tags.map(({ tag, count }) => (
          <li class="tag-item" data-tag={tag.toLowerCase()}>
            <a href={`${baseUrl}tags/${tagSlug(tag)}/`} class="tag">
              <span class="tag-name">{tag}</span>
              <span class="tag-count">
                {count}
                <span class="sr-only">{count === 1 ? 'post' : 'posts'}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="no-match" id="tag-empty" role="status" hidden>No tags match.</p>
  </main>

  <script>
    const input = document.getElementById(
      'tag-search'
    ) as HTMLInputElement | null;
    const items = document.querySelectorAll<HTMLElement>('.tag-item');
    const empty = document.getElementById('tag-empty');

    const filter = () => {
      const query = input?.value.trim().toLowerCase() ?? '';
      let shown = 0;
      for (const item of items) {
        const match = !query || (item.dataset.tag ?? '').includes(query);
        item.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    input?.addEventListener('input', filter);
    input?.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && input.value) {
        input.value = '';
        filter();
      }
    });

    // "/" jumps to the filter, unless the key is being typed into a field.
    document.addEventListener('keydown', (e) => {
      if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
      const target = e.target;
      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        (target instanceof HTMLElement && target.isContentEditable)
      ) {
        return;
      }
      e.preventDefault();
      input?.focus();
    });
  </script>
</BaseLayout>

<style>
  .filter {
    margin: 2rem 0 1.25rem;
  }

  #tag-search {
    width: 100%;
    max-width: 20rem;
    height: 2.25rem;
    padding: 0 0.75rem;
    font: inherit;
    font-size: 0.9375rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
  }

  #tag-search::placeholder {
    color: var(--color-text-muted);
  }

  #tag-search:focus {
    border-color: var(--color-text-faint);
  }

  /* Two columns, read top to bottom, so the order by count stays easy to
     follow. */
  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: 3rem;
  }

  .tag-item {
    break-inside: avoid;
    border-bottom: 1px solid var(--color-border-light);
  }

  .tag {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    color: var(--color-text);
    text-decoration: none;
  }

  .tag-name {
    font-size: 0.9375rem;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .tag:hover .tag-name {
    text-decoration-line: underline;
  }

  .tag-count {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .no-match {
    color: var(--color-text-muted);
    margin: 1rem 0 0;
  }

  @media (max-width: 640px) {
    .tag-list {
      columns: 1;
    }
  }
</style>
