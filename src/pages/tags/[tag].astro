---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { shouldShowDrafts } from '../../utils/env';
import { tagLabel, tagSlug } from '../../utils/tags';

export async function getStaticPaths() {
  const showDrafts = shouldShowDrafts();
  const allPosts = await getCollection('blog');
  const publishedPosts = allPosts.filter(
    (post) => showDrafts || !post.data.draft
  );

  const uniqueTags = [
    ...new Set(publishedPosts.flatMap((post) => post.data.tags)),
  ];

  // Slugs are lossy ("C#" and "C" both give "c"); fail loudly rather than
  // let one tag page silently overwrite another.
  const slugOwners = new Map<string, string>();
  for (const tag of uniqueTags) {
    const slug = tagSlug(tag);
    const owner = slugOwners.get(slug);
    if (!slug || owner) {
      throw new Error(
        `Tag "${tag}" has slug "${slug}"` +
          (owner ? `, already used by "${owner}"` : '') +
          '. Rename one of the tags.'
      );
    }
    slugOwners.set(slug, tag);
  }

  return uniqueTags.map((tag) => {
    const filteredPosts = publishedPosts
      .filter((post) => post.data.tags.includes(tag))
      .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

    const relatedTagCounts = filteredPosts.reduce(
      (acc, post) => {
        post.data.tags.forEach((t) => {
          if (t !== tag) acc[t] = (acc[t] || 0) + 1;
        });
        return acc;
      },
      {} as Record<string, number>
    );

    const relatedTags = Object.entries(relatedTagCounts)
      .sort(([, a], [, b]) => b - a)
      .slice(0, 8)
      .map(([t]) => t);

    return {
      params: { tag: tagSlug(tag) },
      props: { tag, posts: filteredPosts, relatedTags },
    };
  });
}

const { tag, posts, relatedTags } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={`${tag} — Jongmin Lee`} description={`Posts tagged ${tag}.`}>
  <Header />

  <main class="container page" id="main-content">
    <h1 class="page-title">{tag}</h1>
    <p class="page-lead">
      {posts.length}
      {posts.length === 1 ? 'post' : 'posts'}
      <span aria-hidden="true">·</span>
      <a href={`${baseUrl}tags/`} class="text-link">All tags</a>
    </p>

    <div class="posts">
      <PostList
        posts={posts.map((post) => ({
          slug: post.id,
          title: post.data.title,
          description: post.data.description,
          pubDate: post.data.pubDate,
        }))}
      />
    </div>

    {
      relatedTags.length > 0 && (
        <section class="related" aria-labelledby="related-tags">
          <h2 class="related-title" id="related-tags">
            Related tags
          </h2>
          <ul class="related-list" role="list">
            {relatedTags.map((t) => (
              <li>
                <a
                  href={`${baseUrl}tags/${tagSlug(t)}/`}
                  class="related-tag"
                  set:text={tagLabel(t)}
                />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </main>
</BaseLayout>

<style>
  .posts {
    margin-top: 2.5rem;
  }

  .related {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .related-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.5rem;
  }

  .related-list {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.875rem;
    row-gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .related-tag {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s ease;
  }

  /* The "#" is drawn, with empty alt text so screen readers skip it. */
  .related-tag::before {
    content: '#';
    content: '#' / '';
  }

  .related-tag:hover {
    color: var(--color-text);
  }
</style>
