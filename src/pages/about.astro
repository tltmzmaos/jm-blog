---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import {
  CAREER,
  EDUCATION,
  EMAIL,
  GITHUB_URL,
  LINKEDIN_URL,
} from '../utils/site';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="About — Jongmin Lee"
  description="Software engineer in the Bay Area."
>
  <Header />

  <main class="container page about" id="main-content">
    <h1 class="page-title">Jongmin Lee</h1>
    <p class="page-lead">Software Engineer · Bay Area</p>

    <p class="bio">
      I've worked across industries — automotive, life sciences, and now applied
      AI. Each move has taken me into a new domain, and I've gotten used to
      picking up context quickly and figuring out <mark
        >what actually matters</mark
      >.
    </p>

    {
      /* A short page on purpose: three labeled lists, set like a colophon,
         the labels in a narrow column on the left. */
    }
    <section class="row" aria-labelledby="work">
      <h2 class="label" id="work">Work</h2>
      <ul class="list" role="list">
        {
          CAREER.map(({ years, label }) => (
            <li class="work">
              <span class="years">{years}</span>
              <span>{label}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row" aria-labelledby="education">
      <h2 class="label" id="education">Education</h2>
      <ul class="list" role="list">
        {EDUCATION.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <section class="row" aria-labelledby="contact">
      <h2 class="label" id="contact">Contact</h2>
      <p class="contact">
        <a href={`mailto:${EMAIL}`} class="text-link">Email</a>
        <span aria-hidden="true">·</span>
        <a href={GITHUB_URL} class="text-link">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href={LINKEDIN_URL} class="text-link">LinkedIn</a>
        <span aria-hidden="true">·</span>
        <a href={`${baseUrl}rss.xml`} class="text-link">RSS</a>
      </p>
    </section>
  </main>
</BaseLayout>

<style>
  .about {
    padding-bottom: 6rem;
  }

  /* The one paragraph, a size up from body text, with the page's only
     mark on its last words. */
  .bio {
    max-width: 34em;
    margin: 2.5rem 0 4rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  /* The marked words stay together on one line. */
  .bio mark {
    white-space: nowrap;
  }

  .row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .label {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Years in a column of their own, so the labels line up. */
  .work {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
  }

  .years {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .bio {
      margin: 2rem 0 3rem;
      font-size: 1.0625rem;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.375rem;
    }

    .work {
      grid-template-columns: 6.75rem minmax(0, 1fr);
    }
  }
</style>
