---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { tagSlug } from '../utils/tags';
import { CAREER, EDUCATION, LINKEDIN_URL, WRITING_TOPICS } from '../utils/site';

// Counted from published posts, so the numbers follow the writing.
const published = (await getCollection('blog')).filter((p) => !p.data.draft);
const topics = WRITING_TOPICS.map((topic) => ({
  ...topic,
  count: published.filter((p) => p.data.tags.includes(topic.tag)).length,
})).filter((topic) => topic.count > 0);

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="About — Jongmin Lee"
  description="Software engineer in the Bay Area."
>
  <Header />

  <main class="container page about" id="main-content">
    <h1 class="page-title">Jongmin Lee</h1>
    <p class="page-lead">Software Engineer · Bay Area</p>

    <p class="bio">
      I build AI-powered applications. The part I care about most is getting
      language models to behave <mark>predictably inside ordinary software</mark
      > — knowing what they can answer from, and what to do when they can't.
    </p>

    {
      /* A short page on purpose: labeled lists, the labels in a narrow
         column on the left. Writing shows what the notes are about rather
         than saying it; the full work history lives on LinkedIn. */
    }
    <section class="row" aria-labelledby="writing">
      <h2 class="label" id="writing">Writing</h2>
      <ul class="list" role="list">
        {
          topics.map(({ label, tag, count }) => (
            <li class="topic">
              <a href={`${baseUrl}tags/${tagSlug(tag)}/`} class="text-link">
                {label}
              </a>
              <span class="count">
                {count} {count === 1 ? 'post' : 'posts'}
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="row" aria-labelledby="work">
      <h2 class="label" id="work">Work</h2>
      <div>
        <ul class="list" role="list">
          {
            CAREER.map(({ years, label }) => (
              <li class="work">
                <span class="years">{years}</span>
                <span>{label}</span>
              </li>
            ))
          }
        </ul>
        <p class="more">
          <a href={LINKEDIN_URL} class="text-link">
            Full work history on LinkedIn <span aria-hidden="true">→</span>
          </a>
        </p>
      </div>
    </section>

    <section class="row" aria-labelledby="education">
      <h2 class="label" id="education">Education</h2>
      <ul class="list" role="list">
        {EDUCATION.map((line) => <li>{line}</li>)}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .about {
    padding-bottom: 6rem;
  }

  /* The one paragraph, a size up from body text, with the page's only
     mark on its last words. */
  .bio {
    max-width: 34em;
    margin: 2.5rem 0 4rem;
    font-size: 1.1875rem;
    line-height: 1.6;
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  .row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1.5rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .label {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text);
  }

  /* Years in a column of their own, so the labels line up. */
  .work {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: baseline;
    column-gap: 1rem;
  }

  /* A topic and how many posts it has, the count set like the years. */
  .topic {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .count {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .more {
    margin: 0.75rem 0 0;
    font-size: 0.9375rem;
  }

  .years {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .bio {
      margin: 2rem 0 3rem;
      font-size: 1.0625rem;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.375rem;
    }

    .work {
      grid-template-columns: 6.75rem minmax(0, 1fr);
    }
  }
</style>
