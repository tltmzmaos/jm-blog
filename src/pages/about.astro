---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import { CAREER, EDUCATION } from '../utils/site';
---

<BaseLayout
  title="About | Jongmin Lee"
  description="Software engineer in the Bay Area."
>
  <Header />

  <main class="container page about" id="main-content">
    <h1 class="page-title">Jongmin Lee</h1>
    <p class="page-lead">Software Engineer in the Bay Area</p>

    <p class="bio">
      This blog is mostly <mark>notes to myself</mark>: things I want to
      remember, things I'm studying, and things I've run into at work.
    </p>

    {/* Two lists, in the same row shape as the posts on the home page. */}
    <section class="group" aria-labelledby="work">
      <h2 class="label" id="work">Work</h2>
      <ul class="list" role="list">
        {CAREER.map(({ dates, label, detail }) => <li class="entry">
          <p class="name">{label}</p>
          <p class="dates">{dates}</p>
          <p class="detail">{detail}</p>
        </li>)}
      </ul>
    </section>

    <section class="group" aria-labelledby="education">
      <h2 class="label" id="education">Education</h2>
      <ul class="list" role="list">
        {EDUCATION.map(({ dates, school, degree }) => <li class="entry">
          <p class="name">{school}</p>
          <p class="dates">{dates}</p>
          <p class="detail">{degree}</p>
        </li>)}
      </ul>
    </section>
  </main>
</BaseLayout>

<style>
  .about {
    padding-bottom: 5rem;
  }

  /* The one sentence, a step up from body text. The page's only mark is
     in it. */
  .bio {
    max-width: 32em;
    margin: 2rem 0 0;
    font-size: 1.3125rem;
    line-height: 1.5;
    color: var(--color-text-body);
    text-wrap: pretty;
  }

  .bio mark {
    white-space: nowrap;
  }

  .group {
    margin-top: 3rem;
  }

  .label {
    margin: 0;
    padding-bottom: 0.625rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.6;
    color: var(--color-text-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Name and date on one line, the detail under them, a hairline between
     rows: the values match PostListItem and the home page's rows. */
  .entry {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .name {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text);
  }

  .dates {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .detail {
    grid-column: 1 / -1;
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }

  /* Phones: one column, the date on a line of its own under the name, as
     on the home page. */
  @media (max-width: 640px) {
    .about {
      padding-bottom: 3rem;
    }

    .bio {
      font-size: 1.1875rem;
    }

    .group {
      margin-top: 2.5rem;
    }

    .entry {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }

    .detail {
      margin-top: 0.25rem;
    }
  }
</style>
