---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getSeriesInfo } from '../../utils/seriesPosts';
import { getAllSeries } from '../../utils/seriesIndex';
import { shouldShowDrafts } from '../../utils/env';

export async function getStaticPaths() {
  const showDrafts = shouldShowDrafts();
  const posts = await getCollection('blog');
  const visible = posts.filter((post) => showDrafts || !post.data.draft);
  return visible.map((post) => ({
    params: { slug: post.id },
    props: post,
  }));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content, headings } = await render(post);

// Build the visible-post universe once and reuse for nav and series
const allPosts = await getCollection('blog');
const visiblePosts = allPosts.filter(
  (p) => shouldShowDrafts() || !p.data.draft
);
const sortedPosts = visiblePosts.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const currentIndex = sortedPosts.findIndex((p) => p.id === post.id);

const prevPost =
  currentIndex < sortedPosts.length - 1
    ? {
        slug: sortedPosts[currentIndex + 1].id,
        title: sortedPosts[currentIndex + 1].data.title,
        description: sortedPosts[currentIndex + 1].data.description,
      }
    : undefined;

const nextPost =
  currentIndex > 0
    ? {
        slug: sortedPosts[currentIndex - 1].id,
        title: sortedPosts[currentIndex - 1].data.title,
        description: sortedPosts[currentIndex - 1].data.description,
      }
    : undefined;

// Detect series membership
const seriesInfo = getSeriesInfo(post.id, await getAllSeries());
---

<PostLayout
  frontmatter={post.data}
  headings={headings}
  prevPost={prevPost}
  nextPost={nextPost}
  seriesInfo={seriesInfo}
  content={post.body}
  slug={post.id}
>
  <Content />
</PostLayout>
