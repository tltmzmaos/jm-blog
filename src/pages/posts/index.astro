---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { shouldShowDrafts } from '../../utils/env';
import { getEntryNumbers } from '../../utils/entryNumbers';

const showDrafts = shouldShowDrafts();
const entries = await getEntryNumbers();
const posts = (await getCollection('blog'))
  .filter((post) => showDrafts || !post.data.draft)
  .map((post) => ({
    slug: post.id,
    title: post.data.title,
    description: post.data.description,
    pubDate: post.data.pubDate,
    entry: entries.get(post.id),
  }));

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Posts — Jongmin Lee"
  description="Every post, newest first, grouped by year."
>
  <Header />

  <main class="container page" id="main-content">
    <h1 class="page-title">Posts</h1>
    <p class="page-lead">
      All {posts.length} posts, newest first. Also by
      <a href={`${baseUrl}series/`} class="text-link">series</a> and
      <a href={`${baseUrl}tags/`} class="text-link">tag</a>.
    </p>

    <div class="posts">
      <PostList posts={posts} hangingYears />
    </div>

    {posts.length === 0 && <p class="empty">No posts yet.</p>}
  </main>
</BaseLayout>

<style>
  .posts {
    margin-top: 3rem;
  }

  .empty {
    color: var(--color-text-muted);
  }
</style>
