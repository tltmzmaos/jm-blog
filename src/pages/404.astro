---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Not Found — Jongmin Lee"
  description="This page doesn't exist."
  noindex
>
  <Header />
  <main class="container page" id="main-content">
    <h1 class="page-title">This page got lost.</h1>
    <p class="page-lead">
      The address you followed doesn't lead anywhere — at least not here. The
      post may have moved, or the link might be a typo.
    </p>
    <nav class="links" aria-label="Recovery">
      <a href={baseUrl} class="text-link">All posts</a>
      <span aria-hidden="true">·</span>
      <a href={`${baseUrl}tags/`} class="text-link">Tags</a>
      <span aria-hidden="true">·</span>
      <a href={`${baseUrl}series/`} class="text-link">Series</a>
    </nav>
  </main>
</BaseLayout>

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--color-text-muted);
  }
</style>
