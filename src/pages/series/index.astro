---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import { getAllSeries, displayPartTitle } from '../../utils/seriesIndex';

const seriesList = await getAllSeries();
const baseUrl = import.meta.env.BASE_URL;

const formatMonthYear = (date?: Date) => {
  if (!date) return '';
  return new Intl.DateTimeFormat('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
};

const formatRange = (first?: Date, last?: Date) => {
  if (!first || !last) return '';
  const a = formatMonthYear(first);
  const b = formatMonthYear(last);
  return a === b ? a : `${a} – ${b}`;
};

const formatShortDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(date);
---

<BaseLayout
  title="Series — Jongmin Lee"
  description="Long-form, multi-part explorations. Each one was written as I worked through the material myself."
>
  <Header />

  <main class="container page" id="main-content">
    <h1 class="page-title">Series</h1>
    <p class="page-lead">
      Long-form, multi-part explorations. Each one was written as I worked
      through the material myself.
    </p>

    {
      seriesList.map((s) => (
        <section class="series" id={s.dir} aria-labelledby={`${s.dir}-title`}>
          <h2 class="series-title" id={`${s.dir}-title`}>
            {s.title}
          </h2>
          <p class="series-meta">
            {s.count} {s.count === 1 ? 'part' : 'parts'}
            <span aria-hidden="true"> · </span>
            {formatRange(s.firstDate, s.lastDate)}
            {s.status === 'ongoing' && (
              <>
                <span aria-hidden="true"> · </span>
                Ongoing
              </>
            )}
          </p>
          <p class="series-desc">{s.description}</p>

          <ol class="parts" role="list">
            {s.posts.map((post, i) => (
              <li class="part">
                <span class="part-num">
                  {s.sortBy === 'part' && post.partNumber
                    ? post.partNumber
                    : i + 1}
                </span>
                <a href={`${baseUrl}posts/${post.slug}/`} class="part-link">
                  {displayPartTitle(post.title, s)}
                </a>
                <time class="part-date" datetime={post.pubDate.toISOString()}>
                  {formatShortDate(post.pubDate)}
                </time>
              </li>
            ))}
          </ol>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  .series {
    margin-top: 3rem;
    scroll-margin-top: 1.5rem;
  }

  .series-title {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--color-text);
    margin: 0;
  }

  .series-meta {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    margin: 0.25rem 0 0;
  }

  .series-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0.625rem 0 0;
  }

  .parts {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .part {
    display: grid;
    grid-template-columns: 1.75rem 1fr auto;
    align-items: baseline;
    column-gap: 0.75rem;
    padding: 0.625rem 0;
    border-bottom: 1px solid var(--color-border-light);
  }

  .part-num {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .part-link {
    min-width: 0;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-line: none;
  }

  .part-link:hover {
    text-decoration-line: underline;
  }

  .part-date {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (max-width: 640px) {
    .series {
      margin-top: 2.5rem;
    }

    .part {
      grid-template-columns: 1.5rem 1fr;
    }

    .part-date {
      grid-column: 2;
      margin-top: 0.125rem;
    }
  }
</style>
