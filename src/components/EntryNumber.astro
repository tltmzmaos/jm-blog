---
import { formatEntryNumber } from '../utils/entryNumbers';

export interface Props {
  /** The post's entry number (utils/entryNumbers.ts). */
  n: number;
  /** Read as the bare number, where a label already says what it is. */
  bare?: boolean;
  class?: string;
}

const { n, bare = false, class: className } = Astro.props;
// Drawn as "№ 016"; read as "Entry 16".
---

<span class:list={['entry-no', className]}
  ><span class="sr-only">{bare ? n : `Entry ${n}`}</span><span
    aria-hidden="true">№&nbsp;{formatEntryNumber(n)}</span
  ></span
>

<style>
  .entry-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
