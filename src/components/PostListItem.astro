---
import { postTitleTransitionName } from '../utils/viewTransition';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
  /** Publishing order; lists sort same-day posts by it. Not shown. */
  entry?: number;
  /** Show the year in the date; leave it out under a year heading. */
  withYear?: boolean;
  /** Title and date only. */
  compact?: boolean;
  /** Carry the title's view-transition-name. Only one title per post on
   *  a page may, so a post shown twice gets it on its first row only. */
  morph?: boolean;
}

const {
  title,
  description,
  pubDate,
  slug,
  withYear = false,
  compact = false,
  morph = true,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
// A compact row in a list of titles needs only the month.
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: compact ? undefined : 'numeric',
  year: withYear ? 'numeric' : undefined,
  timeZone: 'UTC',
}).format(pubDate);
---

<article class:list={['post', { compact }]}>
  <h3
    class:list={['title', { 'post-title-vt': morph }]}
    style={morph
      ? `--post-title-vt: ${postTitleTransitionName(slug)}`
      : undefined}
  >
    <a href={`${baseUrl}posts/${slug}/`}>{title}</a>
  </h3>
  <p class="meta">
    <time class="date" datetime={pubDate.toISOString()}>{formattedDate}</time>
  </p>
  {!compact && <p class="description">{description}</p>}
</article>

<style>
  .post {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
  }

  /* As wide as its words, not the column: the morph into the post's h1
     (see .post-title-vt) scales the box, and a box wider than the text
     would shrink the words on the way. */
  .title {
    justify-self: start;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
  }

  .title a {
    color: var(--color-text);
    text-decoration-line: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .title a:hover {
    text-decoration-line: underline;
  }

  /* A compact row is one line in a list of titles, so it reads lighter. */
  .compact .title {
    font-size: 1rem;
    font-weight: 400;
  }

  /* Date in Plex Mono, right-aligned. */
  .meta {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 1rem;
    margin: 0;
  }

  .date {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .description {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Phones: one column. The date goes on a line of its own under the
     title, so the title keeps the full width. */
  @media (max-width: 640px) {
    .post {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 0.125rem;
    }

    .meta {
      justify-content: flex-start;
      gap: 0.875rem;
    }

    .description {
      margin-top: 0.25rem;
    }
  }
</style>
