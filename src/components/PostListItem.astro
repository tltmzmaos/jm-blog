---
import { postTitleTransitionName } from '../utils/viewTransition';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  slug: string;
}

const { title, description, pubDate, slug } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
// The year is the heading of the group this row sits in.
const formattedDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
}).format(pubDate);
---

<article class="post">
  <h3
    class="title post-title-vt"
    style={`--post-title-vt: ${postTitleTransitionName(slug)}`}
  >
    <a href={`${baseUrl}posts/${slug}/`}>{title}</a>
  </h3>
  <time class="date" datetime={pubDate.toISOString()}>{formattedDate}</time>
  <p class="description">{description}</p>
</article>

<style>
  .post {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 1.5rem;
    row-gap: 0.25rem;
  }

  /* As wide as its words, not the column: the morph into the post's h1
     (see .post-title-vt) scales the box, and a box wider than the text
     would shrink the words on the way. */
  .title {
    justify-self: start;
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    margin: 0;
  }

  .title a {
    color: var(--color-text);
    text-decoration-line: none;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .title a:hover {
    text-decoration-line: underline;
  }

  .date {
    font-size: 0.875rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .description {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* Phones: the description can run under the date. */
  @media (max-width: 640px) {
    .description {
      grid-column: 1 / -1;
    }
  }
</style>
