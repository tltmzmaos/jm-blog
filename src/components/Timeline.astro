---
import type { Timeline } from '../utils/timeline';
import { formatEntryNumber } from '../utils/entryNumbers';

export interface Props {
  timeline: Timeline;
}

const { timeline } = Astro.props;
const { lanes, start, years } = timeline;
const baseUrl = import.meta.env.BASE_URL;

const count = lanes.reduce((n, lane) => n + lane.marks.length, 0);
const fmt = (d: Date, opts: Intl.DateTimeFormatOptions) =>
  new Intl.DateTimeFormat('en-US', { ...opts, timeZone: 'UTC' }).format(d);
const startLabel = fmt(start, { month: 'short', year: 'numeric' });
const longStart = fmt(start, { month: 'long', year: 'numeric' });
---

{
  /* Every post on one time axis, a lane per topic shelf. Each mark is a
     link whose text (the post's number, date and title) is visually
     hidden until the mark is pointed at or focused; then it shows on the
     lane's label line. So the lanes read as lists of posts to a screen
     reader, and work as plain links without the script below, which only
     adds arrow keys and aiming at the nearest mark. */
}
<figure class="timeline" data-timeline>
  <figcaption class="sr-only">
    All {count} posts since {longStart}, by topic. Arrow keys move between
    posts.
  </figcaption>
  <div class="tl-plot">
    {
      lanes.map((lane, l) => (
        <div class="tl-lane" role="group" aria-labelledby={`tl-lane-${l}`}>
          <p class="tl-label" id={`tl-lane-${l}`}>
            {lane.title}
          </p>
          <ul
            class="tl-marks"
            role="list"
            style={`--from: ${(lane.marks[0]?.x ?? 0).toFixed(4)}; --to: ${(lane.marks.at(-1)?.x ?? 0).toFixed(4)}`}
          >
            {lane.marks.map((mark) => (
              <li style={`--x: ${mark.x.toFixed(4)}`}>
                <a
                  href={`${baseUrl}posts/${mark.slug}/`}
                  class:list={['tl-mark', { newest: mark.newest }]}
                >
                  <span class="tl-tip">
                    {mark.entry !== undefined && (
                      <span class="tl-tip-no" aria-hidden="true">
                        №&nbsp;{formatEntryNumber(mark.entry)}
                      </span>
                    )}
                    <span class="tl-tip-title">{mark.title}</span>
                    <time
                      class="tl-tip-date"
                      datetime={mark.pubDate.toISOString()}
                    >
                      {fmt(mark.pubDate, {
                        month: 'short',
                        day: 'numeric',
                        year: 'numeric',
                      })}
                    </time>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="tl-axis" aria-hidden="true">
    <span class="tl-tick" style="--x: 0">{startLabel}</span>
    {
      years.map(({ year, x }) => (
        <span class="tl-tick" style={`--x: ${x.toFixed(4)}`}>
          {year}
        </span>
      ))
    }
    <span class="tl-tick tl-now" style="--x: 1">Now</span>
  </div>
</figure>

<script>
  // Arrow keys move between marks (one Tab stop for the whole figure):
  // left and right along a lane, up and down to the closest mark in time
  // on the next lane. A pointer anywhere on a lane aims at the closest
  // mark, so marks a few pixels apart can still be told apart.
  const figure = document.querySelector<HTMLElement>('[data-timeline]');
  if (figure) {
    const lanes = [...figure.querySelectorAll<HTMLElement>('.tl-lane')].map(
      (lane) => ({
        el: lane,
        marks: [...lane.querySelectorAll<HTMLAnchorElement>('.tl-mark')],
      })
    );
    const all = lanes.flatMap((lane) => lane.marks);
    const xOf = (a: HTMLElement) =>
      Number(a.parentElement?.style.getPropertyValue('--x') || 0);

    let stop = all.find((a) => a.classList.contains('newest')) ?? all[0];
    const roam = (to: HTMLAnchorElement, focus: boolean) => {
      stop.tabIndex = -1;
      stop = to;
      stop.tabIndex = 0;
      if (focus) stop.focus();
    };
    all.forEach((a) => (a.tabIndex = a === stop ? 0 : -1));

    figure.addEventListener('focusin', (e) => {
      if (e.target instanceof HTMLAnchorElement && all.includes(e.target)) {
        roam(e.target, false);
      }
    });

    figure.addEventListener('keydown', (e) => {
      const l = lanes.findIndex((lane) => lane.marks.includes(stop));
      const lane = lanes[l];
      const i = lane.marks.indexOf(stop);
      let to: HTMLAnchorElement | undefined;
      if (e.key === 'ArrowRight') to = lane.marks[i + 1];
      else if (e.key === 'ArrowLeft') to = lane.marks[i - 1];
      else if (e.key === 'Home') to = lane.marks[0];
      else if (e.key === 'End') to = lane.marks[lane.marks.length - 1];
      else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        const next = lanes[l + (e.key === 'ArrowDown' ? 1 : -1)];
        const x = xOf(stop);
        to = next?.marks.reduce((a, b) =>
          Math.abs(xOf(b) - x) < Math.abs(xOf(a) - x) ? b : a
        );
      } else return;
      e.preventDefault();
      if (to) roam(to, true);
    });

    // Pointer: the closest mark on the lane under it.
    let near: HTMLAnchorElement | undefined;
    const aim = (a?: HTMLAnchorElement) => {
      if (a === near) return;
      near?.classList.remove('is-near');
      near = a;
      near?.classList.add('is-near');
      figure.classList.toggle('is-aiming', !!near);
    };
    for (const lane of lanes) {
      const row = lane.el.querySelector<HTMLElement>('.tl-marks');
      if (!row || lane.marks.length === 0) continue;
      row.addEventListener('pointermove', (e) => {
        const box = row.getBoundingClientRect();
        const x = (e.clientX - box.left) / box.width;
        aim(
          lane.marks.reduce((a, b) =>
            Math.abs(xOf(b) - x) < Math.abs(xOf(a) - x) ? b : a
          )
        );
      });
      row.addEventListener('pointerleave', () => aim(undefined));
      // A click between marks opens the one being aimed at.
      row.addEventListener('click', (e) => {
        if (near && !(e.target as Element).closest('.tl-mark')) near.click();
      });
    }
  }
</script>

<style>
  /* About 150px tall at full width: four lanes, each a label line over a
     row of marks, and the years under them. */
  .timeline {
    position: relative;
    margin: 0;
  }

  .tl-plot {
    position: relative;
  }

  .tl-lane {
    position: relative;
  }

  .tl-lane + .tl-lane {
    margin-top: 0.25rem;
  }

  .tl-label {
    margin: 0;
    font-size: 0.75rem;
    line-height: 1rem;
    color: var(--color-text-secondary);
  }

  /* The row of marks: a faint baseline across the whole axis, darker from
     the lane's first post to its last, and each post a short upright
     stroke in the text color, the newest with a highlighter pass behind
     it. */
  .tl-marks {
    --stroke: 2px;
    display: grid;
    height: 0.75rem;
    margin: 0.125rem 0 0;
    padding: 0;
    list-style: none;
  }

  .is-aiming .tl-marks {
    cursor: pointer;
  }

  .tl-marks::before {
    content: '';
    grid-area: 1 / 1;
    align-self: end;
    height: 1px;
    background: linear-gradient(
      to right,
      var(--color-border-light) calc(var(--from) * 100%),
      var(--color-text-faint) calc(var(--from) * 100%) calc(var(--to) * 100%),
      var(--color-border-light) calc(var(--to) * 100%)
    );
  }

  .tl-marks li {
    grid-area: 1 / 1;
    width: 0.5625rem;
    margin-left: calc(var(--x) * 100% - 0.28125rem);
  }

  .tl-mark {
    display: block;
    height: 100%;
    background: linear-gradient(var(--color-text), var(--color-text)) center
      bottom / var(--stroke) 100% no-repeat;
    border-radius: 1px;
    outline-offset: 1px;
  }

  .tl-mark.newest {
    background:
      linear-gradient(var(--color-text), var(--color-text)) center bottom /
        var(--stroke) 100% no-repeat,
      linear-gradient(var(--color-mark), var(--color-mark)) center bottom / 100%
        100% no-repeat;
  }

  /* The mark being shown: the one the script aims at while a pointer is
     on the lanes, else the one hovered or focused. The others step back. */
  .timeline:is(:hover, :focus-within, .is-aiming)
    .tl-mark:not(
      .is-near,
      .timeline:not(.is-aiming) :is(:hover, :focus-visible)
    ) {
    opacity: 0.45;
  }

  /* On load the strokes rise from the baseline, left to right in time,
     in under half a second. Only the stroke moves; with reduced motion
     the strip is simply there. */
  @media (prefers-reduced-motion: no-preference) {
    .tl-mark {
      transition: opacity 0.15s ease;
      transform-origin: 50% 100%;
      animation: tl-rise 0.24s ease-out backwards;
      animation-delay: calc(var(--x) * 0.24s + 0.05s);
    }
  }

  @keyframes tl-rise {
    from {
      transform: scaleY(0);
    }
  }

  /* The mark's text: visually hidden (the shared .sr-only recipe) until
     the mark is pointed at or focused, then shown on the right of the
     lane's label line. The lane is the nearest positioned box. */
  .tl-tip {
    position: absolute;
    top: 0;
    right: 0;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .tl-mark.is-near .tl-tip,
  .timeline:not(.is-aiming) .tl-mark:is(:hover, :focus-visible) .tl-tip {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    width: auto;
    max-width: calc(100% - 13rem);
    height: auto;
    margin: 0;
    clip-path: none;
    font-size: 0.75rem;
    line-height: 1.125rem;
    color: var(--color-text);
    background: var(--color-bg);
    padding-left: 0.5rem;
  }

  .tl-tip-no,
  .tl-tip-date {
    flex: none;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-text-muted);
  }

  .tl-tip-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* The time axis: a hairline with a short tick at each new year. */
  .tl-axis {
    position: relative;
    height: 1.125rem;
    margin-top: 0.375rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.125rem;
    color: var(--color-text-muted);
  }

  .tl-tick {
    position: absolute;
    left: calc(var(--x) * 100%);
    white-space: nowrap;
  }

  .tl-tick::before {
    content: '';
    position: absolute;
    top: -0.25rem;
    left: 0;
    width: 1px;
    height: 0.3125rem;
    background: var(--color-text-faint);
  }

  .tl-now {
    left: auto;
    right: 0;
  }

  .tl-now::before {
    left: auto;
    right: 0;
  }

  /* Phones: hairline strokes, so a burst of posts stays a row of lines
     rather than a block. */
  @media (max-width: 640px) {
    .tl-marks {
      --stroke: 1px;
    }

    .tl-mark .tl-tip {
      max-width: 60%;
    }
  }
</style>
