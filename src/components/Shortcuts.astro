---
// A few single-key shortcuts, listed in a small native dialog that "?"
// (or the button in the footer) opens. Keys never fire while typing in a
// field, with a modifier held, or while another dialog is open.
const keys: { keys: string[]; what: string }[] = [
  { keys: ['/'], what: 'Search posts' },
  { keys: ['t'], what: 'Switch between light and dark' },
  { keys: ['['], what: 'Previous post or part' },
  { keys: [']'], what: 'Next post or part' },
  {
    keys: ['←', '→', '↑', '↓'],
    what: 'Move along the timeline on the home page',
  },
  { keys: ['?'], what: 'Show this list' },
];
---

<dialog class="keys" aria-labelledby="keys-title">
  <div class="keys-head">
    <h2 id="keys-title">Keyboard shortcuts</h2>
    <form method="dialog">
      <button class="keys-close">Close</button>
    </form>
  </div>
  <dl class="keys-list">
    {
      keys.map(({ keys, what }) => (
        <div>
          <dt>
            {keys.map((k) => (
              <kbd>{k}</kbd>
            ))}
          </dt>
          <dd>{what}</dd>
        </div>
      ))
    }
  </dl>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.keys');

  const typing = (t: EventTarget | null) =>
    t instanceof HTMLInputElement ||
    t instanceof HTMLTextAreaElement ||
    t instanceof HTMLSelectElement ||
    (t instanceof HTMLElement && t.isContentEditable);

  const click = (selector: string) =>
    document.querySelector<HTMLElement>(selector)?.click();

  document.addEventListener('keydown', (e) => {
    if (e.defaultPrevented || e.metaKey || e.ctrlKey || e.altKey) return;
    if (typing(e.target)) return;
    // Another dialog (search, an enlarged image, this list) has the keys.
    if (
      document.querySelector('dialog[open], #search-modal.open') &&
      e.key !== '?'
    ) {
      return;
    }

    switch (e.key) {
      case '/':
        // The tags page uses "/" for its own filter.
        if (document.getElementById('tag-search')) return;
        click('#search-trigger');
        break;
      case 't':
        click('.theme-toggle');
        break;
      case '[':
        click('.article-footer a[rel="prev"]');
        break;
      case ']':
        click('.article-footer a[rel="next"]');
        break;
      case '?':
        if (dialog?.open) dialog.close();
        else if (!document.querySelector('dialog[open], #search-modal.open')) {
          dialog?.showModal();
        }
        break;
      default:
        return;
    }
    e.preventDefault();
  });

  // The footer's button opens the same list.
  document
    .querySelector('[data-open-keys]')
    ?.addEventListener('click', () => dialog?.showModal());

  // A click on the backdrop closes it.
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>

<style>
  .keys {
    width: min(26rem, calc(100vw - 2rem));
    margin: 14vh auto auto;
    padding: 1rem 1.25rem 1.25rem;
    color: var(--color-text);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .keys::backdrop {
    background: rgb(0 0 0 / 0.2);
  }

  :global(.dark) .keys::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .keys-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .keys h2 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .keys-close {
    height: 1.75rem;
    padding: 0 0.625rem;
    font: inherit;
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    background: transparent;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    cursor: pointer;
  }

  .keys-close:hover {
    color: var(--color-text);
  }

  .keys-list {
    margin: 0;
  }

  .keys-list div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    align-items: baseline;
    padding: 0.4375rem 0;
    border-top: 1px solid var(--color-border-light);
  }

  .keys-list dt {
    display: flex;
    gap: 0.25rem;
  }

  .keys-list dd {
    margin: 0;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }

  kbd {
    display: inline-block;
    min-width: 1.375rem;
    padding: 0 0.3125rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.375rem;
    text-align: center;
    color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 3px;
  }
</style>
