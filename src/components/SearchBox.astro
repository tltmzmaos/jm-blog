---

---

<div class="search-wrapper">
  <button
    class="search-trigger"
    type="button"
    aria-label="Search"
    id="search-trigger"
  >
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="8"></circle>
      <path d="m21 21-4.35-4.35"></path>
    </svg>
  </button>

  <div
    class="search-modal"
    id="search-modal"
    role="dialog"
    aria-modal="true"
    aria-label="Search"
  >
    <div class="search-backdrop" id="search-backdrop"></div>
    <div class="search-panel">
      <div class="search-header">
        <svg
          class="header-icon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.35-4.35"></path>
        </svg>
        <input
          type="text"
          class="search-input"
          id="search-input"
          aria-label="Search posts"
          placeholder="Search posts"
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <div class="search-body" id="search-body">
        <div class="search-count" id="search-count" role="status"></div>
        <div class="search-results" id="search-results"></div>
        <p class="search-message search-loading" id="search-loading">
          Loading posts…
        </p>
        <p class="search-message search-empty" id="search-empty">
          Search titles, descriptions and tags.
        </p>
        <p class="search-message search-no-results" id="search-no-results">
          No posts match.
        </p>
      </div>

      <p class="search-footer">
        <kbd>↑</kbd>
        <kbd>↓</kbd> to move · <kbd>Enter</kbd> to open ·
        <kbd>Esc</kbd> to close
      </p>
    </div>
  </div>
</div>

<style>
  .search-wrapper {
    position: relative;
  }

  /* Trigger Button */
  .search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .search-trigger:hover {
    color: var(--color-text);
  }

  /* Dialog */
  .search-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    padding: 12vh 1rem 1rem;
  }

  .search-modal.open {
    display: flex;
    align-items: flex-start;
    justify-content: center;
  }

  .search-backdrop {
    position: fixed;
    inset: 0;
    background: var(--color-overlay);
  }

  .search-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    max-width: 560px;
    max-height: 70vh;
    overflow: hidden;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .search-header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .header-icon {
    flex-shrink: 0;
    color: var(--color-text-muted);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    font: inherit;
    font-size: 1rem;
    color: var(--color-text);
    background: transparent;
    border: none;
    outline: none;
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }

  .search-body {
    flex: 1;
    overflow-y: auto;
    min-height: 120px;
  }

  .search-count {
    display: none;
    padding: 0.5rem 1rem 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .search-count.visible {
    display: block;
  }

  .search-results {
    display: none;
    padding: 0.25rem 0;
  }

  .search-results.has-results {
    display: block;
  }

  .search-results :global(.search-result) {
    display: block;
    padding: 0.625rem 1rem;
    text-decoration: none;
  }

  .search-results :global(.search-result:hover),
  .search-results :global(.search-result.selected) {
    background: var(--color-surface);
  }

  .search-results :global(.sr-head) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .search-results :global(.sr-title) {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text);
  }

  .search-results :global(.sr-date) {
    flex-shrink: 0;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .search-results :global(.sr-desc) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.125rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
  }

  .search-results :global(.sr-tags) {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .search-results :global(.sr-tag) {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  /* The "#" is drawn, with empty alt text so screen readers skip it. */
  .search-results :global(.sr-tag)::before {
    content: '#';
    content: '#' / '';
    margin-right: 0.05em;
  }

  /* One message at a time: loading, the empty prompt, or no matches. */
  .search-message {
    display: none;
    margin: 0;
    padding: 1rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }

  .search-body:not(.has-query) .search-empty,
  .search-body.no-results .search-no-results {
    display: block;
  }

  .search-body.loading .search-loading {
    display: block;
  }

  .search-body.loading .search-empty {
    display: none;
  }

  .search-footer {
    margin: 0;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    border-top: 1px solid var(--color-border);
  }

  .search-footer kbd {
    font: inherit;
  }

  @media (max-width: 640px) {
    .search-modal {
      padding: 1rem;
    }

    .search-panel {
      max-height: 80vh;
    }

    .search-footer {
      display: none;
    }
  }
</style>

<script>
  import type Fuse from 'fuse.js';
  import { tagLabel } from '../utils/tags';

  interface Post {
    title: string;
    description: string;
    slug: string;
    tags: string[];
    pubDate: string;
  }

  // Filled on the first search of this page load.
  let postsData: Post[] = [];
  let fuse: Fuse<Post> | null = null;

  async function loadPosts(searchBody: HTMLElement | null) {
    if (postsData.length > 0) return;
    searchBody?.classList.add('loading');
    try {
      const response = await fetch('/api/posts.json');
      if (!response.ok) throw new Error('Failed to fetch posts');
      // Loaded here, not at the top, so pages only pay for Fuse when
      // someone actually searches.
      const [data, { default: FuseCtor }] = await Promise.all([
        response.json() as Promise<Post[]>,
        import('fuse.js'),
      ]);
      postsData = data;
      fuse = new FuseCtor(postsData, {
        keys: [
          { name: 'title', weight: 2 },
          { name: 'description', weight: 1 },
          { name: 'tags', weight: 1.5 },
        ],
        threshold: 0.3,
      });
    } catch (error) {
      console.error('Search: Failed to load posts:', error);
    } finally {
      searchBody?.classList.remove('loading');
    }
  }

  function escapeHtml(text: string): string {
    const div = document.createElement('div');
    div.textContent = text || '';
    return div.innerHTML;
  }

  function initSearch() {
    const trigger = document.getElementById('search-trigger');
    const modal = document.getElementById('search-modal');
    const backdrop = document.getElementById('search-backdrop');
    const input = document.getElementById(
      'search-input'
    ) as HTMLInputElement | null;
    const resultsContainer = document.getElementById('search-results');
    const searchBody = document.getElementById('search-body');
    const searchCount = document.getElementById('search-count');

    if (!trigger || !modal || !input) return;

    // Keep modal under body so fixed positioning escapes stacking contexts
    if (modal.parentElement !== document.body) {
      document.body.appendChild(modal);
    }

    let selectedIndex = -1;
    let results: Post[] = [];

    const dateFmt = new Intl.DateTimeFormat('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
      timeZone: 'UTC',
    });

    // While the modal is open, everything behind it is inert: focus can't
    // tab out of the dialog and screen readers don't read the page.
    let returnFocusTo: HTMLElement | null = null;
    const setBackgroundInert = (inert: boolean) => {
      for (const el of Array.from(document.body.children)) {
        if (el !== modal && el instanceof HTMLElement) el.inert = inert;
      }
    };

    const openModal = () => {
      if (modal.classList.contains('open')) return;
      returnFocusTo =
        document.activeElement instanceof HTMLElement
          ? document.activeElement
          : null;
      modal.classList.add('open');
      setBackgroundInert(true);
      document.body.style.overflow = 'hidden';
      // The index loads on the first search of each page; whatever was typed
      // while it loaded is searched once it arrives.
      loadPosts(searchBody).then(() => {
        if (modal.classList.contains('open')) handleSearch(input.value.trim());
      });
      setTimeout(() => input.focus(), 50);
    };

    const closeModal = () => {
      if (!modal.classList.contains('open')) return;
      modal.classList.remove('open');
      setBackgroundInert(false);
      returnFocusTo?.focus();
      returnFocusTo = null;
      document.body.style.overflow = '';
      input.value = '';
      if (resultsContainer) {
        resultsContainer.innerHTML = '';
        resultsContainer.classList.remove('has-results');
      }
      searchBody?.classList.remove('has-query', 'no-results');
      if (searchCount) {
        searchCount.textContent = '';
        searchCount.classList.remove('visible');
      }
      results = [];
      selectedIndex = -1;
    };

    const renderResults = (items: Post[]) => {
      results = items;
      selectedIndex = items.length > 0 ? 0 : -1;
      if (!resultsContainer) return;

      resultsContainer.innerHTML = items
        .map((post, index) => {
          const tagsHtml = post.tags?.length
            ? '<span class="sr-tags">' +
              post.tags
                .slice(0, 3)
                .map(
                  (tag) =>
                    `<span class="sr-tag">${escapeHtml(tagLabel(tag))}</span>`
                )
                .join('') +
              '</span>'
            : '';
          const dateStr = post.pubDate
            ? dateFmt.format(new Date(post.pubDate))
            : '';
          const dateHtml = dateStr
            ? `<span class="sr-date">${escapeHtml(dateStr)}</span>`
            : '';
          return `<a href="/posts/${post.slug}/" class="search-result${
            index === 0 ? ' selected' : ''
          }" data-index="${index}">
            <span class="sr-head">
              <span class="sr-title">${escapeHtml(post.title)}</span>
              ${dateHtml}
            </span>
            <span class="sr-desc">${escapeHtml(post.description)}</span>
            ${tagsHtml}
          </a>`;
        })
        .join('');
    };

    const updateSelection = () => {
      if (!resultsContainer) return;
      const items = resultsContainer.querySelectorAll('.search-result');
      items.forEach((el, i) => {
        el.classList.toggle('selected', i === selectedIndex);
        if (i === selectedIndex) el.scrollIntoView({ block: 'nearest' });
      });
    };

    const handleSearch = (query: string) => {
      if (!fuse || query.length < 2) {
        searchBody?.classList.remove('has-query', 'no-results');
        resultsContainer?.classList.remove('has-results');
        if (resultsContainer) resultsContainer.innerHTML = '';
        if (searchCount) {
          searchCount.textContent = '';
          searchCount.classList.remove('visible');
        }
        results = [];
        selectedIndex = -1;
        return;
      }

      searchBody?.classList.add('has-query');
      const matches = fuse.search(query);
      const found = matches.slice(0, 8).map((r) => r.item);

      if (found.length > 0) {
        searchBody?.classList.remove('no-results');
        resultsContainer?.classList.add('has-results');
        if (searchCount) {
          searchCount.textContent =
            matches.length === 1 ? '1 result' : `${matches.length} results`;
          searchCount.classList.add('visible');
        }
        renderResults(found);
      } else {
        searchBody?.classList.add('no-results');
        resultsContainer?.classList.remove('has-results');
        if (resultsContainer) resultsContainer.innerHTML = '';
        if (searchCount) {
          searchCount.textContent = '';
          searchCount.classList.remove('visible');
        }
        results = [];
      }
    };

    const onTrigger = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
      openModal();
    };
    const onBackdrop = () => closeModal();
    // Start downloading the index as soon as someone reaches for search.
    const onTriggerIntent = () => loadPosts(searchBody);
    const onInput = (e: Event) =>
      handleSearch((e.target as HTMLInputElement).value.trim());
    const onInputKey = (e: KeyboardEvent) => {
      if (results.length === 0) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        selectedIndex = Math.min(selectedIndex + 1, results.length - 1);
        updateSelection();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        selectedIndex = Math.max(selectedIndex - 1, 0);
        updateSelection();
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const target = results[selectedIndex];
        if (target) window.location.href = `/posts/${target.slug}/`;
      }
    };
    const onGlobalKey = (e: KeyboardEvent) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) {
        closeModal();
      }
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        modal.classList.contains('open') ? closeModal() : openModal();
      }
    };
    const onResultsClick = () => closeModal();

    trigger.addEventListener('click', onTrigger);
    trigger.addEventListener('pointerenter', onTriggerIntent, { once: true });
    trigger.addEventListener('focus', onTriggerIntent, { once: true });
    backdrop?.addEventListener('click', onBackdrop);
    input.addEventListener('input', onInput);
    input.addEventListener('keydown', onInputKey);
    document.addEventListener('keydown', onGlobalKey);
    resultsContainer?.addEventListener('click', onResultsClick);

    // A page restored from the back/forward cache comes back as it was
    // left; don't bring it back with the dialog open over an inert page.
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) closeModal();
    });
  }

  initSearch();
</script>
