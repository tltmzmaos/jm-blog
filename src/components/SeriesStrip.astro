---
import type { SeriesPart } from '../utils/seriesPosts';

export interface Props {
  parts: SeriesPart[];
  /** Part number of the post being read. */
  current: number;
}

const { parts, current } = Astro.props;

// Past this many parts the segments get too thin to read; the text around
// the strip ("Part 3 of 30", the list of parts) is enough then.
const MAX_SEGMENTS = 24;
const show = parts.length > 1 && parts.length <= MAX_SEGMENTS;

const state = (n: number) =>
  n < current ? 'before' : n === current ? 'current' : 'after';
---

{
  /* A picture of where the reader is in the series, not a way to move
     around it: the part titles next to it are the links, and the text
     ("Part 3 of 8") already says what the strip shows, so it is hidden
     from assistive tech. */
  show && <div class="strip" aria-hidden="true">
    {parts.map((part) => (
      <span class:list={['segment', state(part.partNumber)]} />
    ))}
  </div>
}

<style>
  /* One short segment per part, like tally marks. Parts already behind the
     reader are filled with the text color, the one being read with the
     highlighter, and the ones still ahead with the border color. */
  .strip {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 0.625rem;
  }

  /* A width rather than a flex-basis, so the strip also keeps its size
     when it sits inside another flex row. */
  .segment {
    flex: 0 1 auto;
    width: 2rem;
    min-width: 0.5rem;
    height: 0.3125rem;
    border-radius: 1px;
    background: var(--color-text);
  }

  .after {
    background: var(--color-border);
  }

  /* The current part stands a little taller than the rest, so it is found
     by its shape as well as by its color. */
  .current {
    height: 0.625rem;
    background: var(--color-mark);
  }
</style>
