---

---

<button
  class="theme-toggle"
  type="button"
  aria-label="Dark theme"
  aria-pressed="false"
>
  <svg
    class="icon sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <path
      d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
    ></path>
  </svg>
  <svg
    class="icon moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--color-text);
  }

  .icon {
    width: 18px;
    height: 18px;
  }

  /* Light mode: show moon (click to go dark) */
  .sun {
    display: none;
  }

  .moon {
    display: block;
  }

  /* Dark mode: show sun (click to go light) */
  :global(.dark) .sun {
    display: block;
  }

  :global(.dark) .moon {
    display: none;
  }
</style>

<script>
  const toggle = document.querySelector('.theme-toggle');
  const root = document.documentElement;

  // A toggle button keeps one label and reports its state through
  // aria-pressed; changing the label as well would be read twice.
  const syncPressed = () =>
    toggle?.setAttribute(
      'aria-pressed',
      String(root.classList.contains('dark'))
    );
  syncPressed();

  // The theme script in <head> re-applies the theme on a back/forward
  // cache restore; this listener runs after it.
  window.addEventListener('pageshow', (e) => {
    if (e.persisted) {
      root.classList.remove('theme-reveal');
      requested = undefined;
      syncPressed();
    }
  });

  const setTheme = (dark: boolean) => {
    root.classList.toggle('dark', dark);
    root.style.colorScheme = dark ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', dark ? 'dark' : 'light');
    } catch {
      // Storage can be blocked; the choice then lasts for this page only.
    }
    toggle?.setAttribute('aria-pressed', String(dark));

    const bg = getComputedStyle(root).getPropertyValue('--color-bg').trim();
    document
      .querySelectorAll('meta[name="theme-color"]')
      .forEach((m) => m.setAttribute('content', bg));
  };

  // A reveal applies the theme a frame after the click. Until it settles,
  // the theme the last click asked for is the one to flip, so a quick
  // second click undoes the first instead of repeating it.
  let requested: boolean | undefined;
  // The newest reveal; an older one cut short by a quick second click must
  // not clean up after the one that replaced it.
  let reveal: ViewTransition | undefined;

  toggle?.addEventListener('click', () => {
    const dark = !(requested ?? root.classList.contains('dark'));
    const reduce = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    // Without view transitions, or with reduced motion: switch in place.
    if (!('startViewTransition' in document) || reduce) {
      if (!reduce) root.classList.add('theme-transition');
      setTheme(dark);
      setTimeout(() => root.classList.remove('theme-transition'), 200);
      return;
    }

    // Otherwise the new theme is revealed as a circle growing from the
    // middle of this button out to the farthest corner of the window.
    const box = toggle.getBoundingClientRect();
    const x = box.left + box.width / 2;
    const y = box.top + box.height / 2;
    const radius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    );

    root.classList.add('theme-reveal');
    requested = dark;
    const transition = document.startViewTransition(() => setTheme(dark));
    reveal = transition;

    transition.ready
      .then(() => {
        root.animate(
          {
            clipPath: [
              `circle(0px at ${x}px ${y}px)`,
              `circle(${radius}px at ${x}px ${y}px)`,
            ],
          },
          {
            duration: 400,
            easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
            pseudoElement: '::view-transition-new(root)',
          }
        );
      })
      // A skipped transition rejects here; the theme has still changed.
      .catch(() => {});

    const done = () => {
      if (reveal !== transition) return;
      root.classList.remove('theme-reveal');
      requested = undefined;
    };
    transition.finished.then(done, done);
  });
</script>
