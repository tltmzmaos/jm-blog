---

<button
  class="theme-toggle"
  type="button"
  aria-label="Dark theme"
  aria-pressed="false"
>
  <svg
    class="icon sun"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="5"></circle>
    <path
      d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"
    ></path>
  </svg>
  <svg
    class="icon moon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    color: var(--color-text-secondary);
    background: transparent;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  .icon {
    width: 20px;
    height: 20px;
  }

  /* Light mode: show moon (click to go dark) */
  .sun {
    display: none;
  }

  .moon {
    display: block;
  }

  /* Dark mode: show sun (click to go light) */
  :global(.dark) .sun {
    display: block;
  }

  :global(.dark) .moon {
    display: none;
  }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.querySelector('.theme-toggle');
    const root = document.documentElement;

    // A toggle button keeps one label and reports its state through
    // aria-pressed; changing the label as well would be read twice.
    toggle?.setAttribute(
      'aria-pressed',
      String(root.classList.contains('dark'))
    );

    toggle?.addEventListener('click', () => {
      const dark = !root.classList.contains('dark');

      // Enable transition animation
      root.classList.add('theme-transition');

      root.classList.toggle('dark', dark);
      root.style.colorScheme = dark ? 'dark' : 'light';
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch {
        // Storage can be blocked; the choice then lasts for this page only.
      }
      toggle.setAttribute('aria-pressed', String(dark));

      const bg = getComputedStyle(root).getPropertyValue('--color-bg').trim();
      document
        .querySelectorAll('meta[name="theme-color"]')
        .forEach((m) => m.setAttribute('content', bg));

      // Remove class after animation completes (performance)
      setTimeout(() => {
        root.classList.remove('theme-transition');
      }, 200);
    });
  });
</script>
