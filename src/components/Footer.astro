---
import { getCollection } from 'astro:content';
import { shouldShowDrafts } from '../utils/env';
import { GITHUB_URL, LINKEDIN_URL } from '../utils/site';

const showDrafts = shouldShowDrafts();
const lastPost = (await getCollection('blog'))
  .filter((post) => showDrafts || !post.data.draft)
  .reduce<Date | undefined>(
    (latest, post) =>
      !latest || post.data.pubDate > latest ? post.data.pubDate : latest,
    undefined
  );

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);

const baseUrl = import.meta.env.BASE_URL;
---

<!-- A colophon, like the last page of a notebook: where else to find me,
     what the site is made with, and how fresh it is. -->
<footer class="footer">
  <div class="footer-inner">
    <p class="links">
      <a href={`${baseUrl}rss.xml`} class="text-link">RSS</a>
      <span aria-hidden="true">·</span>
      <a href={GITHUB_URL} class="text-link">GitHub</a>
      <span aria-hidden="true">·</span>
      <a href={LINKEDIN_URL} class="text-link">LinkedIn</a>
      <span class="keys-item">
        <span aria-hidden="true">·</span>
        <button type="button" class="keys-button" data-open-keys>
          Shortcuts
        </button>
      </span>
    </p>
    <p class="colophon">
      <span>Set in IBM Plex. Built with Astro.</span>
      {
        lastPost && (
          <span>
            Last post:{' '}
            <time datetime={lastPost.toISOString()}>
              {formatDate(lastPost)}
            </time>
          </span>
        )
      }
    </p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    column-gap: 2rem;
    row-gap: 0.375rem;
    max-width: calc(var(--column) + 3rem);
    margin: 0 auto;
    padding: 1.5rem 1.5rem 2.5rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    gap: 0.5rem;
    margin: 0;
  }

  .colophon time {
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.375rem;
    margin: 0;
  }

  /* Opens the list of shortcuts (components/Shortcuts.astro). Looks like
     the links beside it; only shown where there is likely a keyboard. */
  .keys-item {
    display: contents;
  }

  .keys-button {
    padding: 0;
    font: inherit;
    color: var(--color-text);
    background: none;
    border: 0;
    text-decoration-line: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  @media (hover: none), (pointer: coarse) {
    .keys-item {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      padding: 1.25rem 1rem 2rem;
    }
  }
</style>
