---
import { EMAIL, GITHUB_URL, LINKEDIN_URL, SITE_TITLE } from '../utils/site';

const baseUrl = import.meta.env.BASE_URL;
const year = new Date().getUTCFullYear();

// Line icons, drawn on a 24px grid with the text color, so they read as
// part of the type rather than as brand badges.
const links = [
  {
    label: 'GitHub',
    href: GITHUB_URL,
    paths: [
      'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21',
    ],
  },
  {
    label: 'LinkedIn',
    href: LINKEDIN_URL,
    paths: [
      'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z',
      'M2 9h4v12H2z',
      'M4 2a2 2 0 1 1 0 4 2 2 0 0 1 0-4z',
    ],
  },
  {
    label: 'Email',
    href: `mailto:${EMAIL}`,
    paths: ['M3 5h18v14H3z', 'm3 7 9 6 9-6'],
  },
  {
    label: 'RSS feed',
    href: `${baseUrl}rss.xml`,
    paths: ['M4 11a9 9 0 0 1 9 9', 'M4 4a16 16 0 0 1 16 16', 'M5 19h.01'],
  },
];
---

<footer class="footer">
  <div class="footer-inner">
    <p class="owner">© {year} {SITE_TITLE}</p>
    <ul class="links" role="list">
      {links.map((link) => <li>
        <a href={link.href} aria-label={link.label} title={link.label}>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            {link.paths.map((d) => (
              <path d={d} />
            ))}
          </svg>
        </a>
      </li>)}
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border);
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: calc(var(--column) + 3rem);
    margin: 0 auto;
    padding: 1.25rem 1.5rem 2rem;
  }

  .owner {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    gap: 0.25rem;
    margin: 0 -0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 4px;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .links a:hover,
  .links a:focus-visible {
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .links a {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .footer-inner {
      padding: 1rem 1rem 1.75rem;
    }
  }
</style>
