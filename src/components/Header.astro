---
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';

const baseUrl = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

// The active link is the current section: a post counts as "Posts", since
// the archive at /posts/ lists it, and a tag page counts as "Tags". The
// home page is the name on the left, so no link is active there.
const isActive = (href: string) => pathname.startsWith(href);

const links = [
  { href: `${baseUrl}posts/`, label: 'Posts' },
  { href: `${baseUrl}series/`, label: 'Series' },
  { href: `${baseUrl}tags/`, label: 'Tags' },
  { href: `${baseUrl}about/`, label: 'About' },
].map((link) => ({
  ...link,
  active: isActive(link.href),
  current: pathname === link.href,
}));
---

<header class="header">
  <div class="header-inner">
    <a href={baseUrl} class="site-name">Jongmin Lee</a>

    <nav class="nav" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: link.active }]}
            aria-current={link.current ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <SearchBox />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'name nav actions';
    align-items: center;
    column-gap: 1.75rem;
    max-width: calc(var(--column) + 3rem);
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
  }

  .site-name {
    grid-area: name;
    justify-self: start;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav {
    grid-area: nav;
    display: flex;
    gap: 1.25rem;
  }

  /* The current section is marked with a short, thick highlighter stroke
     behind the lower half of the word; hovering another item sweeps in a
     fainter pass of the same pen. The stroke runs a little past each end
     of the word (padding), and the matching negative margin keeps the
     words where they were. Text on the stroke is always --color-text. */
  .nav-link {
    margin: 0 -0.2em;
    padding: 0 0.2em;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    background-image: linear-gradient(
      var(--color-mark-wash),
      var(--color-mark-wash)
    );
    background-repeat: no-repeat;
    background-position: 0 0.72em;
    background-size: 0 0.56em;
  }

  .nav-link:is(:hover, :focus-visible) {
    color: var(--color-text);
    background-size: 100% 0.56em;
  }

  .nav-link.active {
    color: var(--color-text);
    background-image: linear-gradient(var(--color-mark), var(--color-mark));
    background-size: 100% 0.56em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link {
      transition:
        color 0.15s ease,
        background-size 0.2s ease-out;
    }
  }

  .actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 0.125rem;
    /* The icon buttons carry their own padding; this lines the last icon
       up with the right edge of the text column. */
    margin-right: -0.5rem;
  }

  /* Too narrow for one row: the links move under the name. */
  @media (max-width: 559px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'name actions'
        'nav nav';
      row-gap: 0.25rem;
      padding: 0.625rem 1rem 0.75rem;
    }
  }
</style>
