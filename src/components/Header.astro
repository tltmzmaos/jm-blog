---
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';

const baseUrl = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

// The active link is the current section: posts count as "Posts", since
// that's where they are listed, and a tag page counts as "Tags".
const isActive = (href: string) =>
  href === baseUrl
    ? pathname === baseUrl || pathname.startsWith(`${baseUrl}posts/`)
    : pathname.startsWith(href);

const links = [
  { href: baseUrl, label: 'Posts' },
  { href: `${baseUrl}series/`, label: 'Series' },
  { href: `${baseUrl}tags/`, label: 'Tags' },
  { href: `${baseUrl}about/`, label: 'About' },
].map((link) => ({
  ...link,
  active: isActive(link.href),
  current: pathname === link.href,
}));
---

<header class="header">
  <div class="header-inner">
    <a href={baseUrl} class="site-name">Jongmin Lee</a>

    <nav class="nav" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: link.active }]}
            aria-current={link.current ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <SearchBox />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'name nav actions';
    align-items: center;
    column-gap: 1.75rem;
    max-width: calc(680px + 3rem);
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
  }

  .site-name {
    grid-area: name;
    justify-self: start;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }

  .nav {
    grid-area: nav;
    display: flex;
    gap: 1.25rem;
  }

  .nav-link {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    text-underline-offset: 0.4em;
    text-decoration-thickness: 1px;
    transition: color 0.15s ease;
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link.active {
    color: var(--color-text);
    text-decoration-line: underline;
  }

  .actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 0.125rem;
    /* The icon buttons carry their own padding; this lines the last icon
       up with the right edge of the text column. */
    margin-right: -0.5rem;
  }

  /* Too narrow for one row: the links move under the name. */
  @media (max-width: 559px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'name actions'
        'nav nav';
      row-gap: 0.25rem;
      padding: 0.625rem 1rem 0.75rem;
    }
  }
</style>
