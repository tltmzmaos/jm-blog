---
import ThemeToggle from './ThemeToggle.astro';
import SearchBox from './SearchBox.astro';
import Monogram from './Monogram.astro';

const baseUrl = import.meta.env.BASE_URL;
const pathname = Astro.url.pathname;

// The active link is the current section. "Posts" is the home page, the
// list of every post; a post counts as Posts too.
const isActive = (href: string) =>
  href === baseUrl
    ? pathname === baseUrl || pathname.startsWith(`${baseUrl}posts/`)
    : pathname.startsWith(href);

const links = [
  { href: baseUrl, label: 'Posts' },
  { href: `${baseUrl}series/`, label: 'Series' },
  { href: `${baseUrl}about/`, label: 'About' },
].map((link) => ({
  ...link,
  active: isActive(link.href),
  current: pathname === link.href,
}));
---

<header class="header">
  <div class="header-inner">
    <div class="site-name">
      <Monogram href={baseUrl} />
    </div>

    <nav class="nav" aria-label="Main">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={['nav-link', { active: link.active }]}
            aria-current={link.current ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <SearchBox />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: 'name nav actions';
    align-items: center;
    column-gap: 1.75rem;
    max-width: calc(var(--column) + 3rem);
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
  }

  /* The mark's letters line up with the text column's edge; its click
     area reaches past it into the gutter. */
  .site-name {
    grid-area: name;
    justify-self: start;
    display: flex;
    margin-left: -0.375rem;
  }

  .nav {
    grid-area: nav;
    display: flex;
    gap: 1.25rem;
  }

  /* The current section is underlined, so the highlighter stays rare; the
     mark next to it is already yellow. Hovering another item sweeps in a
     faint pass of the pen. The stroke runs a little past each end of the
     word (padding), and the matching negative margin keeps the words where
     they were. Text on the stroke is always --color-text. */
  .nav-link {
    margin: 0 -0.2em;
    padding: 0 0.2em;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    text-decoration: none;
    background-image: linear-gradient(
      var(--color-mark-wash),
      var(--color-mark-wash)
    );
    background-repeat: no-repeat;
    background-position: 0 0.78em;
    background-size: 0 0.52em;
  }

  .nav-link:is(:hover, :focus-visible) {
    color: var(--color-text);
    background-size: 100% 0.52em;
  }

  .nav-link.active {
    color: var(--color-text);
    background-size: 0 0.52em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.35em;
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav-link {
      transition:
        color 0.15s ease,
        background-size 0.2s ease-out;
    }
  }

  .actions {
    grid-area: actions;
    display: flex;
    align-items: center;
    gap: 0.125rem;
    /* The icon buttons carry their own padding; this lines the last icon
       up with the right edge of the text column. */
    margin-right: -0.5rem;
  }

  /* Too narrow for one row: the links move under the name. */
  @media (max-width: 559px) {
    .header-inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'name actions'
        'nav nav';
      row-gap: 0.25rem;
      padding: 0.625rem 1rem 0.75rem;
    }
  }
</style>
