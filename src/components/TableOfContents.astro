---
import type { Section } from '../utils/sections';

export interface Props {
  /** The post's h2s (utils/sections.ts): h3s made the list as long as the
   *  article on some posts. Numbered like the headings, when they are. */
  sections: Section[];
  /** sidebar: fixed beside the article on wide screens.
   *  inline: collapsed block at the top of the article on narrower ones. */
  variant?: 'sidebar' | 'inline';
}

const { sections, variant = 'sidebar' } = Astro.props;
const numbered = sections.some((s) => s.n !== undefined);
---

{
  sections.length > 0 &&
    (variant === 'sidebar' ? (
      <nav class="toc-sidebar" aria-label="Table of contents">
        <p class="toc-title">Contents</p>
        <ul class:list={['toc-list', { numbered }]}>
          {sections.map((section) => (
            <li>
              <a
                href={`#${section.slug}`}
                class="toc-link"
                data-slug={section.slug}
              >
                {numbered && (
                  <span class="toc-num" aria-hidden="true">
                    {section.n}
                  </span>
                )}
                <span class="toc-text">{section.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <nav class="toc-inline" aria-label="Table of contents">
        <details>
          <summary>Contents</summary>
          <ul class:list={['toc-inline-list', { numbered }]}>
            {sections.map((section) => (
              <li>
                {numbered && (
                  <span class="toc-num" aria-hidden="true">
                    {section.n}
                  </span>
                )}
                <a href={`#${section.slug}`}>{section.text}</a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    ))
}

<style>
  /* Fixed in the right margin on wide screens. The offset keeps a 40px gap
     between the text column and the list; below 1240px there isn't room,
     and the inline block takes over. */
  .toc-sidebar {
    position: fixed;
    top: 6.5rem;
    right: max(calc((100vw - var(--column)) / 2 - 260px), 24px);
    width: 220px;
    max-height: calc(100vh - 8.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.625rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-border);
  }

  .toc-link {
    display: block;
    padding: 0.3125rem 0 0.3125rem 0.875rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--color-text);
  }

  /* Section numbers, as in the margin of the article. The number is
     taken out of the line so the words stay one inline run, which the
     highlighter stroke needs. */
  .numbered .toc-link {
    position: relative;
    padding-left: 2.5rem;
  }

  .toc-num {
    position: absolute;
    left: 0.875rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  /* The section being read (set by scripts/reading.ts) gets a highlighter
     stroke behind its words, drawn in as the reader scrolls into it.
     Wrapped titles get one per line. */
  .toc-text {
    background-image: linear-gradient(var(--color-mark), var(--color-mark));
    background-repeat: no-repeat;
    background-position: 0 var(--mark-top);
    background-size: 0 var(--mark-height);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .toc-link.active {
    color: var(--color-text);
  }

  .toc-link.active .toc-text {
    background-size: 100% var(--mark-height);
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc-text {
      transition: background-size 0.2s ease-out;
    }
  }

  .toc-inline {
    display: none;
    margin: 0 0 2rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .toc-inline summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    list-style: none;
    cursor: pointer;
  }

  .toc-inline summary::-webkit-details-marker {
    display: none;
  }

  /* Chevron: points right when closed, down when open. */
  .toc-inline summary::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }

  .toc-inline details[open] summary::before {
    transform: translate(0, -0.125rem) rotate(45deg);
  }

  .toc-inline summary:hover {
    color: var(--color-text);
  }

  .toc-inline-list {
    list-style: none;
    margin: 0.75rem 0 0.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .toc-inline-list.numbered li {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    align-items: baseline;
  }

  .toc-inline-list a {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-line: none;
  }

  .toc-inline-list a:hover {
    color: var(--color-text);
    text-decoration-line: underline;
  }

  @media (max-width: 1239px) {
    .toc-sidebar {
      display: none;
    }

    .toc-inline {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .toc-inline {
      padding: 0.75rem 1rem;
    }
  }
</style>
