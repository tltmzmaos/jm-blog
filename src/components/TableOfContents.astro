---
export interface Props {
  headings: Array<{ depth: number; slug: string; text: string }>;
  /** sidebar: fixed beside the article on wide screens.
   *  inline: collapsed block at the top of the article on narrower ones. */
  variant?: 'sidebar' | 'inline';
}

const { headings, variant = 'sidebar' } = Astro.props;

// Sections only: h3s made the list as long as the article on some posts.
const sections = headings.filter((h) => h.depth === 2);
---

{
  sections.length > 0 &&
    (variant === 'sidebar' ? (
      <nav class="toc-sidebar" aria-label="Table of contents">
        <p class="toc-title">Contents</p>
        <ul class="toc-list">
          {sections.map((heading) => (
            <li>
              <a
                href={`#${heading.slug}`}
                class="toc-link"
                data-slug={heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ) : (
      <nav class="toc-inline" aria-label="Table of contents">
        <details>
          <summary>Contents</summary>
          <ul class="toc-inline-list">
            {sections.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </details>
      </nav>
    ))
}

<style>
  /* Fixed in the right margin on wide screens. The offset keeps a 40px gap
     between the text column and the list; below 1240px there isn't room,
     and the inline block takes over. */
  .toc-sidebar {
    position: fixed;
    top: 6.5rem;
    right: max(calc((100vw - var(--column)) / 2 - 260px), 24px);
    width: 220px;
    max-height: calc(100vh - 8.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.625rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-border);
  }

  .toc-link {
    display: block;
    margin-left: -1px;
    padding: 0.3125rem 0 0.3125rem 0.875rem;
    border-left: 1px solid transparent;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--color-text);
  }

  .toc-link.active {
    color: var(--color-text);
    border-left-color: var(--color-text);
  }

  .toc-inline {
    display: none;
    margin: 0 0 2rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .toc-inline summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    list-style: none;
    cursor: pointer;
  }

  .toc-inline summary::-webkit-details-marker {
    display: none;
  }

  /* Chevron: points right when closed, down when open. */
  .toc-inline summary::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }

  .toc-inline details[open] summary::before {
    transform: translate(0, -0.125rem) rotate(45deg);
  }

  .toc-inline summary:hover {
    color: var(--color-text);
  }

  .toc-inline-list {
    list-style: none;
    margin: 0.75rem 0 0.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .toc-inline-list a {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-line: none;
  }

  .toc-inline-list a:hover {
    color: var(--color-text);
    text-decoration-line: underline;
  }

  @media (max-width: 1239px) {
    .toc-sidebar {
      display: none;
    }

    .toc-inline {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .toc-inline {
      padding: 0.75rem 1rem;
    }
  }
</style>

<script>
  function initToc() {
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
    if (tocLinks.length === 0) return;

    const headingElements = Array.from(tocLinks)
      .map((link) => {
        const slug = link.dataset.slug;
        return document.getElementById(slug || '');
      })
      .filter(Boolean) as HTMLElement[];

    if (headingElements.length === 0) return;

    const updateActiveLink = () => {
      const scrollY = window.scrollY;
      const offset = 120;

      // Update active link
      let activeIndex = 0;
      for (let i = 0; i < headingElements.length; i++) {
        if (headingElements[i].offsetTop <= scrollY + offset) {
          activeIndex = i;
        }
      }

      tocLinks.forEach((link, index) => {
        const isActive = index === activeIndex;
        link.classList.toggle('active', isActive);

        // Scroll to keep active link visible
        if (isActive) {
          const toc = link.closest('.toc-sidebar');
          if (toc) {
            const linkRect = link.getBoundingClientRect();
            const tocRect = toc.getBoundingClientRect();
            if (
              linkRect.top < tocRect.top ||
              linkRect.bottom > tocRect.bottom
            ) {
              link.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }
          }
        }
      });
    };

    // Clicking a link is a plain jump to the heading: the browser scrolls
    // (smoothly unless reduced motion is set) and keeps the hash in the URL.

    window.addEventListener('scroll', updateActiveLink, { passive: true });
    updateActiveLink();
  }

  initToc();
</script>
