---
import type { Section } from '../utils/sections';

export interface Props {
  /** The post's h2s (utils/sections.ts): h3s made the list as long as the
   *  article on some posts. */
  sections: Section[];
  /** sidebar: fixed beside the article on wide screens.
   *  inline: collapsed block at the top of the article on narrower ones. */
  variant?: 'sidebar' | 'inline';
}

const { sections, variant = 'sidebar' } = Astro.props;
---

{sections.length > 0 &&
  (variant === 'sidebar' ? (
    <nav class="toc-sidebar" aria-label="Table of contents">
      <span class="toc-glider" aria-hidden="true" />
      <p class="toc-title">Contents</p>
      <ul class="toc-list">
        {sections.map((section) => <li>
          <a
            href={`#${section.slug}`}
            class="toc-link"
            data-slug={section.slug}
          >
            <span class="toc-text">{section.text}</span>
          </a>
        </li>)}
      </ul>
    </nav>
  ) : (
    <nav class="toc-inline" aria-label="Table of contents">
      <details>
        <summary>Contents</summary>
        <ul class="toc-inline-list">
          {sections.map((section) => <li>
            <a href={`#${section.slug}`}>{section.text}</a>
          </li>)}
        </ul>
      </details>
    </nav>
  ))}

<style>
  /* Fixed in the right margin on wide screens. The offset keeps a 40px gap
     between the text column and the list; below 1240px there isn't room,
     and the inline block takes over. */
  /* The nav is also the box the highlighter (.toc-glider) is placed in,
     so it scrolls with the list. */
  .toc-sidebar {
    position: fixed;
    top: 6.5rem;
    right: max(calc((100vw - var(--column)) / 2 - 260px), 24px);
    width: 220px;
    max-height: calc(100vh - 8.5rem);
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .toc-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.625rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--color-border);
  }

  .toc-link {
    position: relative;
    display: block;
    padding: 0.3125rem 0 0.3125rem 0.875rem;
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .toc-link:hover {
    color: var(--color-text);
  }

  .toc-link.active {
    color: var(--color-text);
  }

  /* The highlighter behind the section being read: one element that
     scripts/reading.ts sizes and places over the entry's words, a stroke
     per line (up to three, one background layer each), and that glides
     from entry to entry as the reader moves on. It sits under the links. */
  .toc-glider {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    background-image:
      linear-gradient(var(--color-mark), var(--color-mark)),
      linear-gradient(var(--color-mark), var(--color-mark)),
      linear-gradient(var(--color-mark), var(--color-mark));
    background-repeat: no-repeat;
    background-size: 0 0;
    opacity: 0;
    pointer-events: none;
  }

  .toc-glider.is-on {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .toc-glider.is-gliding {
      transition:
        transform 0.3s cubic-bezier(0.3, 0, 0.2, 1),
        width 0.3s cubic-bezier(0.3, 0, 0.2, 1),
        height 0.3s cubic-bezier(0.3, 0, 0.2, 1),
        background-position 0.3s cubic-bezier(0.3, 0, 0.2, 1),
        background-size 0.3s cubic-bezier(0.3, 0, 0.2, 1),
        opacity 0.2s ease;
    }
  }

  .toc-inline {
    display: none;
    margin: 0 0 2rem;
    padding: 0.75rem 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .toc-inline summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    list-style: none;
    cursor: pointer;
  }

  .toc-inline summary::-webkit-details-marker {
    display: none;
  }

  /* Chevron: points right when closed, down when open. */
  .toc-inline summary::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }

  .toc-inline details[open] summary::before {
    transform: translate(0, -0.125rem) rotate(45deg);
  }

  .toc-inline summary:hover {
    color: var(--color-text);
  }

  .toc-inline-list {
    list-style: none;
    margin: 0.75rem 0 0.25rem;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .toc-inline-list a {
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-text-secondary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-line: none;
  }

  .toc-inline-list a:hover {
    color: var(--color-text);
    text-decoration-line: underline;
  }

  @media (max-width: 1239px) {
    .toc-sidebar {
      display: none;
    }

    .toc-inline {
      display: block;
    }
  }

  @media (max-width: 640px) {
    .toc-inline {
      padding: 0.75rem 1rem;
    }
  }
</style>
