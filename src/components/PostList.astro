---
import PostListItem from './PostListItem.astro';
import { assertUniqueTransitionNames } from '../utils/viewTransition';

interface Post {
  slug: string;
  title: string;
  description: string;
  pubDate: Date;
}

export interface Props {
  posts: Post[];
  /** On wide screens, hang each year in a gutter left of the text column,
   *  where it stays in view while its posts scroll past. */
  hangingYears?: boolean;
}

const { posts, hangingYears = false } = Astro.props;

// Each title carries a view-transition-name made from its slug.
assertUniqueTransitionNames(posts.map((p) => p.slug));

// Newest first, grouped by the year shown in the dates (UTC).
const byYear = new Map<number, Post[]>();
for (const post of [...posts].sort(
  (a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()
)) {
  const year = post.pubDate.getUTCFullYear();
  const group = byYear.get(year) ?? [];
  group.push(post);
  byYear.set(year, group);
}
---

{
  [...byYear].map(([year, group]) => (
    <section
      class:list={['year', { hanging: hangingYears }]}
      aria-labelledby={`year-${year}`}
    >
      <h2 class="year-heading" id={`year-${year}`}>
        {year}
      </h2>
      <ul class="rows" role="list">
        {group.map((post) => (
          <li>
            <PostListItem {...post} />
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .year + .year {
    margin-top: 2.75rem;
  }

  .year-heading {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 1.25rem;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--color-border);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* Wide screens: the year moves out of the text column into a gutter on
     its left, as a large, light numeral. The negative margin hangs the
     gutter in the page margin, so the posts stay in line with the header
     and the intro. The year is sticky inside its own group: it stays at
     the top while that year's posts scroll past, then leaves with them. */
  @media (min-width: 1100px) {
    .hanging {
      --gutter: 8.5rem;
      --gutter-gap: 2.5rem;
      display: grid;
      grid-template-columns: var(--gutter) minmax(0, 1fr);
      column-gap: var(--gutter-gap);
      margin-left: calc(-1 * (var(--gutter) + var(--gutter-gap)));
    }

    .hanging + .hanging {
      margin-top: 3.5rem;
    }

    .hanging .year-heading {
      position: sticky;
      top: 1.5rem;
      align-self: start;
      margin: 0;
      padding: 0;
      border: 0;
      font-size: 2rem;
      font-weight: 400;
      letter-spacing: -0.02em;
      line-height: 1;
      text-align: right;
      color: var(--color-text-muted);
    }
  }
</style>
