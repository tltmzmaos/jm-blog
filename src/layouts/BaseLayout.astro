---
import katex from 'katex';
import SEO from '../components/SEO.astro';
import { DEFAULT_OG_IMAGE, SITE_DESCRIPTION } from '../utils/site';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  hasMath?: boolean;
  slug?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  author,
  hasMath = false,
  slug,
  noindex = false,
} = Astro.props;

// The stylesheet must match the KaTeX that rendered the math at build time.
const katexCss = `https://cdn.jsdelivr.net/npm/katex@${katex.version}/dist/katex.min.css`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <!-- GitHub Pages cannot set response headers; this is the only one
         from the old _headers file that a meta tag can express. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      name="theme-color"
      content="#fbfaf7"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#181715"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Fraunces is self-hosted like Inter (public/fonts). The upright
         face sets every page title, so it is preloaded. -->
    <link
      rel="preload"
      href="/fonts/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      author={author}
      slug={slug}
      hasMath={hasMath}
      noindex={noindex}
    />

    <!-- KaTeX CSS (only loaded on pages with math) -->
    {
      hasMath && (
        <link rel="stylesheet" href={katexCss} crossorigin="anonymous" />
      )
    }

    <title>{title}</title>

    <!-- Prefetch same-site pages on hover (Chromium; ignored elsewhere).
         The client router used to do this in JavaScript. -->
    <script
      is:inline
      type="speculationrules"
      set:html={JSON.stringify({
        prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
      })}
    />

    <!-- Prevent dark mode flash -->
    <script is:inline>
      (function () {
        // Same values as --color-bg; the browser UI color follows the
        // chosen theme, not only the OS setting.
        const BG = { light: '#fbfaf7', dark: '#181715' };
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const stored = () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        };
        const isDark = () => {
          const t = stored();
          return t === 'dark' || (!t && media.matches);
        };
        const apply = (dark) => {
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((m) =>
              m.setAttribute('content', dark ? BG.dark : BG.light)
            );
        };

        apply(isDark());

        media.addEventListener('change', () => {
          if (!stored()) apply(isDark());
        });

        // A page restored from the back/forward cache keeps the theme it
        // had when it was left, even if another page changed it since.
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) apply(isDark());
        });
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <slot />

    <!-- Cloudflare Web Analytics -->
    <script is:inline>
      (function () {
        function load() {
          var s = document.createElement('script');
          s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          s.dataset.cfBeacon = '{"token": "7b9d87031cae435d91c599cde69e59ec"}';
          document.body.appendChild(s);
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(load);
        } else {
          setTimeout(load, 2000);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/inter-latin-400.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/inter-latin-500.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('/fonts/inter-latin-600.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/inter-latin-700.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Variable font: one file covers weights 400-700 and the opsz axis. */
  @font-face {
    font-family: 'Fraunces';
    font-style: normal;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/fraunces-latin.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
      U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Variable font: one file covers weights 400-700 and the opsz axis. */
  @font-face {
    font-family: 'Fraunces';
    font-style: italic;
    font-weight: 400 700;
    font-display: swap;
    src: url('/fonts/fraunces-latin-italic.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
      U+2212, U+2215, U+FEFF, U+FFFD;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Every color lives here. Components use these tokens, and dark mode
     comes from the .dark overrides below, not from per-rule copies. */
  :root {
    --color-bg: #fbfaf7;
    --color-bg-secondary: #f3f0ea;
    --color-bg-tertiary: #f7f5f0;
    --color-surface: #f3f0ea; /* table headers, blockquotes */
    --color-text: #1c1a17;
    --color-text-body: #2b2723; /* article prose */
    --color-text-secondary: #57504a;
    --color-text-subtle: #57504a; /* secondary links: series list, TOC */
    --color-text-soft: #655d55; /* icon buttons, small labels, quotes */
    --color-text-muted: #6e665e;
    --color-text-faint: #cdc5ba; /* heading anchors, TOC markers */
    --color-border: #e6e1d9;
    --color-border-light: #efebe4;
    --color-accent: #a3532f;
    --color-accent-hover: #86432a;
    --color-on-accent: #ffffff;
    --color-selection-bg: var(--color-accent);
    --color-scrollbar: #d3ccc2;
    --color-scrollbar-hover: #a59d93;
    /* Inline code */
    --color-code-inline-text: #7a4129;
    --color-code-inline-bg: #f1ece4;
    --color-code-inline-border: #e6e0d6;
    /* Code blocks stay dark in both themes. */
    --color-code-bg: #1e1c19;
    --color-code-header-bg: #262320;
    --color-code-border: #36322d;
    --color-code-text: #e6e2dc;
    --color-code-muted: #a59d93;
    --color-code-success: #8fb573;
    --image-filter: none;
    --font-serif:
      'Fraunces', 'Iowan Old Style', 'Apple Garamond', 'Baskerville',
      'Times New Roman', serif;
    --font-mono:
      ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Monaco, Consolas,
      monospace;
  }

  .dark {
    --color-bg: #181715;
    --color-bg-secondary: #211f1c;
    --color-bg-tertiary: #272522;
    --color-surface: #211f1c;
    --color-text: #e6e2dc;
    --color-text-body: #dbd6cf;
    --color-text-secondary: #b3aca2;
    --color-text-subtle: #b3aca2;
    --color-text-soft: #a39b91;
    --color-text-muted: #9d958b;
    --color-text-faint: #4a4540;
    --color-border: #34312d;
    --color-border-light: #2c2a27;
    --color-accent: #dc8d69;
    --color-accent-hover: #e7a585;
    --color-on-accent: #181715;
    --color-selection-bg: var(--color-accent);
    --color-scrollbar: #3a3632;
    --color-scrollbar-hover: #524c46;
    --color-code-inline-text: #e2b29a;
    --color-code-inline-bg: #272522;
    --color-code-inline-border: #34312d;
    --image-filter: brightness(0.9);
  }

  html {
    scroll-behavior: smooth;
    scrollbar-gutter: stable;
  }

  /* Native cross-document transitions: a short cross-fade between pages,
     and none at all when reduced motion is requested. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.15s;
    }
  }

  body {
    font-family:
      'Inter',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
    font-feature-settings: 'ss01', 'cv11';
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.65;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  /* Dark mode transition animation */
  .theme-transition,
  .theme-transition *,
  .theme-transition *::before,
  .theme-transition *::after {
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      fill 0.2s ease,
      stroke 0.2s ease !important;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* Selection styles */
  ::selection {
    background: var(--color-selection-bg);
    color: var(--color-on-accent);
  }

  /* Skip to content link */
  /* Visually hidden, still read by screen readers. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-to-content {
    position: fixed;
    top: -100%;
    left: 1rem;
    z-index: 999;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-on-accent);
    background: var(--color-accent);
    border-radius: 0 0 8px 8px;
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-to-content:focus {
    top: 0;
    outline: none;
  }

  /* Focus styles */
  :focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-bg-secondary);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-scrollbar);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-scrollbar-hover);
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
