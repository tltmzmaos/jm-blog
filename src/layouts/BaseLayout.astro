---
import katex from 'katex';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_OG_IMAGE, SITE_DESCRIPTION } from '../utils/site';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  hasMath?: boolean;
  slug?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  author,
  hasMath = false,
  slug,
  noindex = false,
} = Astro.props;

// The stylesheet must match the KaTeX that rendered the math at build time.
const katexCss = `https://cdn.jsdelivr.net/npm/katex@${katex.version}/dist/katex.min.css`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- The page opts in to cross-document view transitions here, inline and
         first, so the opt-in never waits on a stylesheet download. The
         animations themselves are in the global styles below. -->
    <style is:inline>
      @media (prefers-reduced-motion: no-preference) {
        @view-transition {
          navigation: auto;
        }
      }
    </style>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <!-- GitHub Pages cannot set response headers; this is the only one
         from the old _headers file that a meta tag can express. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111111"
      media="(prefers-color-scheme: dark)"
    />

    <!-- IBM Plex is self-hosted (public/fonts). The upright Plex Sans file
         is one variable font for every weight, and it sets nearly all the
         text, so it is fetched before first paint. Plex Mono and the italic
         are small or rare, and load when a page uses them. -->
    <link
      rel="preload"
      href="/fonts/plex-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      author={author}
      slug={slug}
      hasMath={hasMath}
      noindex={noindex}
    />

    <!-- KaTeX CSS (only loaded on pages with math) -->
    {
      hasMath && (
        <link rel="stylesheet" href={katexCss} crossorigin="anonymous" />
      )
    }

    <title>{title}</title>

    <!-- Prefetch same-site pages on hover (Chromium; ignored elsewhere).
         The client router used to do this in JavaScript. -->
    <script
      is:inline
      type="speculationrules"
      set:html={JSON.stringify({
        prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
      })}
    />

    <!-- Prevent dark mode flash -->
    <script is:inline>
      (function () {
        // Same values as --color-bg; the browser UI color follows the
        // chosen theme, not only the OS setting.
        const BG = { light: '#ffffff', dark: '#111111' };
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const stored = () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        };
        const isDark = () => {
          const t = stored();
          return t === 'dark' || (!t && media.matches);
        };
        const apply = (dark) => {
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((m) =>
              m.setAttribute('content', dark ? BG.dark : BG.light)
            );
        };

        apply(isDark());

        media.addEventListener('change', () => {
          if (!stored()) apply(isDark());
        });

        // A page restored from the back/forward cache keeps the theme it
        // had when it was left, even if another page changed it since.
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) apply(isDark());
        });

        // Paper is white: print in the light theme, then switch back.
        window.addEventListener('beforeprint', () => apply(false));
        window.addEventListener('afterprint', () => apply(isDark()));
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <slot />
    <Footer />

    <!-- Cloudflare Web Analytics -->
    <script is:inline>
      (function () {
        function load() {
          var s = document.createElement('script');
          s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          s.dataset.cfBeacon = '{"token": "7b9d87031cae435d91c599cde69e59ec"}';
          document.body.appendChild(s);
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(load);
        } else {
          setTimeout(load, 2000);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  /* IBM Plex, Latin subset (Google Fonts' latin unicode-range). Sans is
     one variable file per style: weight 100-700, width 85-100%. */
  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: normal;
    font-weight: 100 700;
    font-stretch: 85% 100%;
    font-display: swap;
    src: url('/fonts/plex-sans-latin.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
      U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'IBM Plex Sans';
    font-style: italic;
    font-weight: 100 700;
    font-stretch: 85% 100%;
    font-display: swap;
    src: url('/fonts/plex-sans-latin-italic.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
      U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'IBM Plex Mono';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/plex-mono-latin-400.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
      U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'IBM Plex Mono';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/plex-mono-latin-500.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193,
      U+2212, U+2215, U+FEFF, U+FFFD;
  }

  /* Stand-ins while Plex loads: a local Arial (or a font with Arial's
     widths) and Menlo (or Courier New), scaled to Plex's average letter
     width and given Plex's ascent and descent, so the swap doesn't move
     the text. Measured from the font files: Plex Sans averages 0.454 em at
     400, 0.464 at 500 and 0.470 at 600 (0.452 at 600 and 90% width),
     against 0.447 for Arial and 0.484 for Arial Bold; ascent 1.025 em,
     descent 0.275 em, no line gap. Plex Mono and Menlo are both 0.6 em. The
     overrides are divided by size-adjust, which scales them too. */
  @font-face {
    font-family: 'Plex Sans Fallback';
    font-weight: 100 450;
    src:
      local('Arial'), local('ArialMT'), local('Helvetica'),
      local('Liberation Sans');
    size-adjust: 101.6%;
    ascent-override: 100.9%;
    descent-override: 27.1%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'Plex Sans Fallback';
    font-weight: 451 550;
    src:
      local('Arial'), local('ArialMT'), local('Helvetica'),
      local('Liberation Sans');
    size-adjust: 103.8%;
    ascent-override: 98.8%;
    descent-override: 26.5%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'Plex Sans Fallback';
    font-weight: 551 900;
    src:
      local('Arial Bold'), local('Arial-BoldMT'), local('Helvetica Bold'),
      local('Helvetica-Bold'), local('Liberation Sans Bold');
    size-adjust: 97.1%;
    ascent-override: 105.5%;
    descent-override: 28.3%;
    line-gap-override: 0%;
  }

  /* The name on the home page is set at 90% width. */
  @font-face {
    font-family: 'Plex Sans Fallback';
    font-weight: 551 900;
    font-stretch: 85% 95%;
    src:
      local('Arial Bold'), local('Arial-BoldMT'), local('Helvetica Bold'),
      local('Helvetica-Bold'), local('Liberation Sans Bold');
    size-adjust: 93.4%;
    ascent-override: 109.7%;
    descent-override: 29.4%;
    line-gap-override: 0%;
  }

  @font-face {
    font-family: 'Plex Mono Fallback';
    src:
      local('Menlo'), local('Menlo-Regular'), local('Courier New'),
      local('CourierNewPSMT'), local('Liberation Mono');
    size-adjust: 99.7%;
    ascent-override: 102.9%;
    descent-override: 27.6%;
    line-gap-override: 0%;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Every color lives here. Components use these tokens, and dark mode
     comes from the .dark overrides below, not from per-rule copies.
     Neutral greys, plus one highlighter. Every text color is 4.5:1 or
     better on both --color-bg and --color-surface. */
  :root {
    --color-bg: #ffffff;
    --color-surface: #f6f6f6; /* code blocks, inline code */
    --color-text: #171717; /* headings, titles, links */
    --color-text-body: #262626; /* article prose */
    --color-text-secondary: #525252; /* descriptions, nav, secondary links */
    --color-text-muted: #6b6b6b; /* dates, counts, small labels */
    --color-text-faint: #c2c2c2; /* decorative marks only, never text */
    --color-border: #e5e5e5;
    --color-border-light: #efefef;
    --color-link-underline: #b4b4b4;
    /* The highlighter. Only ever a background behind text, never a text
       color, and the text on it is always --color-text (14.1:1 here,
       7.3:1 in dark). --color-mark-wash is a lighter pass of the same pen,
       for hover hints. */
    --color-mark: #ffe45c;
    --color-mark-wash: #fff0a0;
    --color-scrollbar: #d4d4d4;
    --color-scrollbar-hover: #a3a3a3;
    --color-overlay: rgb(0 0 0 / 0.2); /* behind the search dialog */
    --image-filter: none;
    /* Width of the text column on every page: about 68 characters of
       17px Plex Sans, the article body size. */
    --column: 43.5rem;
    /* Where a highlighter stroke sits on an inline run of text: from about
       two thirds up the lowercase letters to just under the baseline. In
       em, so it follows the font size of whatever it marks. Plex's
       baseline sits 1.025em below the top of the text box. */
    --mark-top: 0.66em;
    --mark-height: 0.44em;
    --font-sans:
      'IBM Plex Sans', 'Plex Sans Fallback', -apple-system, BlinkMacSystemFont,
      'Segoe UI', Roboto, sans-serif;
    /* Plex Mono sets code and numbers: dates, entry and section numbers,
       counts. Always in sentence case, never as spaced capitals. */
    --font-mono:
      'IBM Plex Mono', 'Plex Mono Fallback', ui-monospace, Menlo, Consolas,
      monospace;
  }

  .dark {
    --color-bg: #111111;
    --color-surface: #1b1b1b;
    --color-text: #ededed;
    --color-text-body: #d9d9d9;
    --color-text-secondary: #a3a3a3;
    --color-text-muted: #8f8f8f;
    --color-text-faint: #474747;
    --color-border: #262626;
    --color-border-light: #1f1f1f;
    --color-link-underline: #555555;
    --color-mark: #5a4b10;
    --color-mark-wash: #332c0f;
    --color-scrollbar: #333333;
    --color-scrollbar-hover: #4d4d4d;
    --color-overlay: rgb(0 0 0 / 0.6);
    --image-filter: brightness(0.9);
  }

  html {
    scroll-behavior: smooth;
    scrollbar-gutter: stable;
  }

  /* A post's title in the lists and the h1 of the post share a name, set
     per post in --post-title-vt (utils/viewTransition.ts). */
  .post-title-vt {
    view-transition-name: var(--post-title-vt);
    view-transition-class: post-title;
  }

  /* Native cross-document transitions, and none at all when reduced motion
     is requested. The page cross-fades quickly; the title that was clicked
     morphs into the post's h1 (and back again on Back) a little slower, so
     it reads as the one thing that moved. Titles with no partner on the
     other page fade out with the page. Browsers without cross-document
     view transitions just navigate. */
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.15s;
    }

    ::view-transition-group(*.post-title) {
      animation-duration: 0.28s;
      animation-timing-function: ease;
    }

    ::view-transition-old(*.post-title):only-child,
    ::view-transition-new(*.post-title):only-child {
      animation-duration: 0.15s;
    }
  }

  /* Theme switch (ThemeToggle): the new theme is revealed as a circle
     growing from the toggle, a script animation on the new snapshot. For
     that one transition the default cross-fade is off, and so are color
     transitions and the post title names, so the snapshot is the finished
     theme and the whole page is revealed as one piece. */
  .theme-reveal::view-transition-old(root),
  .theme-reveal::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  .theme-reveal *,
  .theme-reveal *::before,
  .theme-reveal *::after {
    transition: none !important;
  }

  .theme-reveal .post-title-vt {
    view-transition-name: none;
  }

  body {
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  /* Dark mode transition animation */
  .theme-transition,
  .theme-transition *,
  .theme-transition *::before,
  .theme-transition *::after {
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      fill 0.2s ease,
      stroke 0.2s ease !important;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* Selecting text marks it with the highlighter. */
  ::selection {
    background: var(--color-mark);
    color: var(--color-text);
  }

  /* The text column, with a 24px gutter (16px on phones). */
  .container {
    max-width: calc(var(--column) + 3rem);
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (max-width: 640px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  /* Index pages (series, tags, about...): a title and one line under it. */
  .page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .page-title {
    font-size: 2.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0;
  }

  .page-lead {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0;
  }

  /* A link inside running text: text color and a light underline at rest.
     On hover or keyboard focus a highlighter stroke sweeps in behind the
     lower part of the words, left to right. The stroke is a background, so
     a link that wraps gets one stroke per line (box-decoration-break).
     Post bodies use it too: .article-content is the Markdown output. */
  .text-link,
  .article-content a:not(.heading-anchor) {
    color: var(--color-text);
    text-decoration-line: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    background-image: linear-gradient(var(--color-mark), var(--color-mark));
    background-repeat: no-repeat;
    background-position: 0 var(--mark-top);
    background-size: 0 var(--mark-height);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .text-link:is(:hover, :focus-visible),
  .article-content a:not(.heading-anchor):is(:hover, :focus-visible) {
    background-size: 100% var(--mark-height);
  }

  @media (prefers-reduced-motion: no-preference) {
    .text-link,
    .article-content a:not(.heading-anchor) {
      transition: background-size 0.2s ease-out;
    }
  }

  /* Marked words: ==text== in a post (plugins/remark-mark.mjs) and the
     words a search matched. A highlighter pass over the words, taller than
     the stroke behind a hovered link and running just past both ends.
     Wrapped marks get one per line. */
  mark {
    margin: 0 -0.1em;
    padding: 0 0.1em;
    color: var(--color-text);
    background: linear-gradient(var(--color-mark), var(--color-mark)) 0 0.38em /
      100% 0.78em no-repeat;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  @media (forced-colors: active) {
    mark {
      background: Mark;
      color: MarkText;
    }
  }

  @media (max-width: 640px) {
    .page {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }

    .page-title {
      font-size: 1.75rem;
    }
  }

  /* Skip to content link */
  /* Visually hidden, still read by screen readers. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-to-content {
    position: fixed;
    top: -100%;
    left: 1rem;
    z-index: 999;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 0 0 4px 4px;
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-to-content:focus {
    top: 0;
    outline: none;
  }

  /* Focus styles */
  :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-bg);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-scrollbar);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-scrollbar-hover);
  }

  /* Printing a page gives the notes alone: the light theme (switched by
     the theme script), no header, footer, contents or buttons, highlighter
     marks kept, and the address after each link that leaves the site. */
  @media print {
    .skip-to-content,
    .header,
    .footer,
    .toc-sidebar,
    .toc-inline,
    #search-modal,
    .heading-anchor,
    .code-header,
    .share,
    .post-nav,
    .series-strip,
    .series-steps,
    .series-all {
      display: none !important;
    }

    .container {
      max-width: none;
      padding: 0;
    }

    .article-content pre {
      padding-top: 1rem !important;
      break-inside: avoid;
    }

    .article-content :is(img, .table-wrap, blockquote) {
      break-inside: avoid;
    }

    .article-content :is(h2, h3, h4) {
      break-after: avoid;
    }

    .article-content a[href^='http']::after {
      content: ' (' attr(href) ')';
      font-size: 0.85em;
      color: var(--color-text-secondary);
      overflow-wrap: anywhere;
    }

    mark {
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
