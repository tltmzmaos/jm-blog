---
import katex from 'katex';
import SEO from '../components/SEO.astro';
import Footer from '../components/Footer.astro';
import { DEFAULT_OG_IMAGE, SITE_DESCRIPTION } from '../utils/site';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  author?: string;
  hasMath?: boolean;
  slug?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  publishedTime,
  modifiedTime,
  tags,
  author,
  hasMath = false,
  slug,
  noindex = false,
} = Astro.props;

// The stylesheet must match the KaTeX that rendered the math at build time.
const katexCss = `https://cdn.jsdelivr.net/npm/katex@${katex.version}/dist/katex.min.css`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <!-- GitHub Pages cannot set response headers; this is the only one
         from the old _headers file that a meta tag can express. -->
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111111"
      media="(prefers-color-scheme: dark)"
    />

    <!-- Inter is self-hosted (public/fonts). Regular sets the body text and
         semibold every title, so both are fetched before first paint. -->
    <link
      rel="preload"
      href="/fonts/inter-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/inter-latin-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <!-- SEO -->
    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
      author={author}
      slug={slug}
      hasMath={hasMath}
      noindex={noindex}
    />

    <!-- KaTeX CSS (only loaded on pages with math) -->
    {
      hasMath && (
        <link rel="stylesheet" href={katexCss} crossorigin="anonymous" />
      )
    }

    <title>{title}</title>

    <!-- Prefetch same-site pages on hover (Chromium; ignored elsewhere).
         The client router used to do this in JavaScript. -->
    <script
      is:inline
      type="speculationrules"
      set:html={JSON.stringify({
        prefetch: [{ where: { href_matches: '/*' }, eagerness: 'moderate' }],
      })}
    />

    <!-- Prevent dark mode flash -->
    <script is:inline>
      (function () {
        // Same values as --color-bg; the browser UI color follows the
        // chosen theme, not only the OS setting.
        const BG = { light: '#ffffff', dark: '#111111' };
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const stored = () => {
          try {
            return localStorage.getItem('theme');
          } catch {
            return null;
          }
        };
        const isDark = () => {
          const t = stored();
          return t === 'dark' || (!t && media.matches);
        };
        const apply = (dark) => {
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
          document
            .querySelectorAll('meta[name="theme-color"]')
            .forEach((m) =>
              m.setAttribute('content', dark ? BG.dark : BG.light)
            );
        };

        apply(isDark());

        media.addEventListener('change', () => {
          if (!stored()) apply(isDark());
        });

        // A page restored from the back/forward cache keeps the theme it
        // had when it was left, even if another page changed it since.
        window.addEventListener('pageshow', (e) => {
          if (e.persisted) apply(isDark());
        });
      })();
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-to-content">Skip to content</a>
    <slot />
    <Footer />

    <!-- Cloudflare Web Analytics -->
    <script is:inline>
      (function () {
        function load() {
          var s = document.createElement('script');
          s.src = 'https://static.cloudflareinsights.com/beacon.min.js';
          s.dataset.cfBeacon = '{"token": "7b9d87031cae435d91c599cde69e59ec"}';
          document.body.appendChild(s);
        }
        if ('requestIdleCallback' in window) {
          requestIdleCallback(load);
        } else {
          setTimeout(load, 2000);
        }
      })();
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('/fonts/inter-latin-400.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('/fonts/inter-latin-500.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url('/fonts/inter-latin-600.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 700;
    font-display: swap;
    src: url('/fonts/inter-latin-700.woff2') format('woff2');
    unicode-range:
      U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC,
      U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191,
      U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Every color lives here. Components use these tokens, and dark mode
     comes from the .dark overrides below, not from per-rule copies.
     Neutral greys, plus one highlighter. Every text color is 4.5:1 or
     better on both --color-bg and --color-surface. */
  :root {
    --color-bg: #ffffff;
    --color-surface: #f6f6f6; /* code blocks, inline code */
    --color-text: #171717; /* headings, titles, links */
    --color-text-body: #262626; /* article prose */
    --color-text-secondary: #525252; /* descriptions, nav, secondary links */
    --color-text-muted: #6b6b6b; /* dates, counts, small labels */
    --color-text-faint: #c2c2c2; /* decorative marks only, never text */
    --color-border: #e5e5e5;
    --color-border-light: #efefef;
    --color-link-underline: #b4b4b4;
    /* The highlighter. Only ever a background behind text, never a text
       color, and the text on it is always --color-text (14.1:1 here,
       7.3:1 in dark). --color-mark-wash is a lighter pass of the same pen,
       for hover hints. */
    --color-mark: #ffe45c;
    --color-mark-wash: #fff0a0;
    --color-scrollbar: #d4d4d4;
    --color-scrollbar-hover: #a3a3a3;
    --color-overlay: rgb(0 0 0 / 0.2); /* behind the search dialog */
    --image-filter: none;
    /* Width of the text column on every page. */
    --column: 680px;
    /* Where a highlighter stroke sits on an inline run of text: from about
       halfway up the lowercase letters to just under the baseline. In em,
       so it follows the font size of whatever it marks. */
    --mark-top: 0.6em;
    --mark-height: 0.44em;
    /* System monospace, for code only: never for dates or labels. */
    --font-mono:
      ui-monospace, 'SF Mono', SFMono-Regular, Menlo, Consolas,
      'Liberation Mono', monospace;
  }

  .dark {
    --color-bg: #111111;
    --color-surface: #1b1b1b;
    --color-text: #ededed;
    --color-text-body: #d9d9d9;
    --color-text-secondary: #a3a3a3;
    --color-text-muted: #8f8f8f;
    --color-text-faint: #474747;
    --color-border: #262626;
    --color-border-light: #1f1f1f;
    --color-link-underline: #555555;
    --color-mark: #5a4b10;
    --color-mark-wash: #332c0f;
    --color-scrollbar: #333333;
    --color-scrollbar-hover: #4d4d4d;
    --color-overlay: rgb(0 0 0 / 0.6);
    --image-filter: brightness(0.9);
  }

  html {
    scroll-behavior: smooth;
    scrollbar-gutter: stable;
  }

  /* A post's title in the lists and the h1 of the post share a name, set
     per post in --post-title-vt (utils/viewTransition.ts). */
  .post-title-vt {
    view-transition-name: var(--post-title-vt);
    view-transition-class: post-title;
  }

  /* Native cross-document transitions, and none at all when reduced motion
     is requested. The page cross-fades quickly; the title that was clicked
     morphs into the post's h1 (and back again on Back) a little slower, so
     it reads as the one thing that moved. Titles with no partner on the
     other page fade out with the page. Browsers without cross-document
     view transitions just navigate. */
  @media (prefers-reduced-motion: no-preference) {
    @view-transition {
      navigation: auto;
    }

    ::view-transition-old(root),
    ::view-transition-new(root) {
      animation-duration: 0.15s;
    }

    ::view-transition-group(*.post-title) {
      animation-duration: 0.28s;
      animation-timing-function: ease;
    }

    ::view-transition-old(*.post-title):only-child,
    ::view-transition-new(*.post-title):only-child {
      animation-duration: 0.15s;
    }
  }

  /* Theme switch (ThemeToggle): the new theme is revealed as a circle
     growing from the toggle, a script animation on the new snapshot. For
     that one transition the default cross-fade is off, and so are color
     transitions and the post title names, so the snapshot is the finished
     theme and the whole page is revealed as one piece. */
  .theme-reveal::view-transition-old(root),
  .theme-reveal::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  .theme-reveal *,
  .theme-reveal *::before,
  .theme-reveal *::after {
    transition: none !important;
  }

  .theme-reveal .post-title-vt {
    view-transition-name: none;
  }

  body {
    font-family:
      'Inter',
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      Roboto,
      sans-serif;
    font-feature-settings: 'ss01', 'cv11';
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    background: var(--color-bg);
    color: var(--color-text);
    line-height: 1.6;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  /* Dark mode transition animation */
  .theme-transition,
  .theme-transition *,
  .theme-transition *::before,
  .theme-transition *::after {
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      fill 0.2s ease,
      stroke 0.2s ease !important;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  /* Selecting text marks it with the highlighter. */
  ::selection {
    background: var(--color-mark);
    color: var(--color-text);
  }

  /* The text column, with a 24px gutter (16px on phones). */
  .container {
    max-width: calc(var(--column) + 3rem);
    margin: 0 auto;
    padding-left: 1.5rem;
    padding-right: 1.5rem;
  }

  @media (max-width: 640px) {
    .container {
      padding-left: 1rem;
      padding-right: 1rem;
    }
  }

  /* Index pages (series, tags, about...): a title and one line under it. */
  .page {
    padding-top: 2.5rem;
    padding-bottom: 4rem;
  }

  .page-title {
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--color-text);
    margin: 0;
  }

  .page-lead {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0.5rem 0 0;
  }

  /* A link inside running text: text color and a light underline at rest.
     On hover or keyboard focus a highlighter stroke sweeps in behind the
     lower part of the words, left to right. The stroke is a background, so
     a link that wraps gets one stroke per line (box-decoration-break).
     Post bodies use it too: .article-content is the Markdown output. */
  .text-link,
  .article-content a:not(.heading-anchor) {
    color: var(--color-text);
    text-decoration-line: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    background-image: linear-gradient(var(--color-mark), var(--color-mark));
    background-repeat: no-repeat;
    background-position: 0 var(--mark-top);
    background-size: 0 var(--mark-height);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .text-link:is(:hover, :focus-visible),
  .article-content a:not(.heading-anchor):is(:hover, :focus-visible) {
    background-size: 100% var(--mark-height);
  }

  @media (prefers-reduced-motion: no-preference) {
    .text-link,
    .article-content a:not(.heading-anchor) {
      transition: background-size 0.2s ease-out;
    }
  }

  @media (max-width: 640px) {
    .page {
      padding-top: 2rem;
      padding-bottom: 3rem;
    }

    .page-title {
      font-size: 1.625rem;
    }
  }

  /* Skip to content link */
  /* Visually hidden, still read by screen readers. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .skip-to-content {
    position: fixed;
    top: -100%;
    left: 1rem;
    z-index: 999;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-bg);
    background: var(--color-text);
    border-radius: 0 0 4px 4px;
    text-decoration: none;
    transition: top 0.2s ease;
  }

  .skip-to-content:focus {
    top: 0;
    outline: none;
  }

  /* Focus styles */
  :focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* Scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: var(--color-bg);
  }

  ::-webkit-scrollbar-thumb {
    background: var(--color-scrollbar);
    border-radius: 4px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--color-scrollbar-hover);
  }

  /* Reduced motion preference */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
      scroll-behavior: auto !important;
    }
  }
</style>
