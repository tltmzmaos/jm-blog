---
import path from 'node:path';
import sharp from 'sharp';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import RunningHeader from '../components/RunningHeader.astro';
import SeriesStrip from '../components/SeriesStrip.astro';
import { calculateReadingTime } from '../utils/readingTime.js';
import type { SeriesInfo } from '../utils/seriesPosts';
import { hasMathContent } from '../utils/hasMath';
import { postTitleTransitionName } from '../utils/viewTransition';
import { postSections } from '../utils/sections';

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    pubDate: Date;
    updatedDate?: Date;
    heroImage?: string;
    tags?: string[];
    author?: string;
  };
  headings?: Array<{ depth: number; slug: string; text: string }>;
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
  seriesInfo?: SeriesInfo | null;
  content?: string;
  slug?: string;
}

const {
  frontmatter,
  headings = [],
  prevPost,
  nextPost,
  seriesInfo,
  content,
  slug: postSlug,
} = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  author = 'Jongmin',
} = frontmatter;

const readingTime = calculateReadingTime(content || description || title);
const slug =
  postSlug ||
  Astro.url.pathname
    .split('/')
    .filter((p) => p)
    .pop() ||
  '';
// Always the generated 1200x630 PNG: hero images are WebP screenshots in
// arbitrary sizes, which some link previews reject or crop badly.
const ogImage = `/og/${slug}.png`;
const postUrl = new URL(`/posts/${slug}/`, Astro.site).toString();

// Real pixel size so the browser reserves the right box before the image loads.
// A missing local file fails the build on purpose; remote URLs aren't measured.
const heroSize = heroImage?.startsWith('/')
  ? await sharp(path.join(process.cwd(), 'public', heroImage)).metadata()
  : undefined;

// Detect math formulas ($ or $$ usage)
const hasMath = hasMathContent(content);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);

const sections = postSections(headings);
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  tags={tags}
  author={author}
  image={ogImage}
  hasMath={hasMath}
  slug={slug}
>
  <Header />

  <RunningHeader title={title} sections={sections} />

  <TableOfContents sections={sections} />

  <main id="main-content" class="container">
    <article class="article">
      <header class="article-header">
        <h1
          class="post-title-vt"
          style={`--post-title-vt: ${postTitleTransitionName(slug)}`}
        >
          {title}
        </h1>

        {description && <p class="description">{description}</p>}

        {/* One row of facts under the title, each in its own cell. */}
        <dl class="facts">
          <div class="fact">
            <dt>Published</dt>
            <dd class="fact-num">
              <time datetime={pubDate.toISOString()}
                >{formatDate(pubDate)}</time
              >
            </dd>
          </div>
          <div class="fact">
            <dt>Reading</dt>
            <dd class="fact-num">{readingTime.minutes} min</dd>
          </div>
          {seriesInfo && <div class="fact fact-wide">
            <dt>Series</dt>
            <dd>
              <a href={`/series/#${seriesInfo.id}`} class="fact-link">
                {seriesInfo.name}
              </a>
              <span class="fact-part">
                part {seriesInfo.currentPart} of {seriesInfo.totalParts}
              </span>
            </dd>
          </div>}
        </dl>
      </header>

      {heroImage && <div class="hero-image">
        <img
          src={heroImage}
          alt={title}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width={heroSize?.width}
          height={heroSize?.height}
        />
      </div>}

      <TableOfContents sections={sections} variant="inline" />

      <div class="article-content">
        <slot />
      </div>

      <footer class="article-footer">
        <div class="share">
          <button
            class="share-btn"
            id="copy-link-btn"
            type="button"
            data-url={postUrl}
          >
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
              ></path>
              <path
                d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
              ></path>
            </svg>
            Copy link
          </button>
          <span class="share-status" id="copy-link-status" role="status"></span>
        </div>

        {seriesInfo && <nav class="series" aria-label="Series">
          <p class="series-title">
            Part {seriesInfo.currentPart} of {seriesInfo.totalParts} in{' '}
            <a href={`/series/#${seriesInfo.id}`} class="text-link">
              {seriesInfo.name}
            </a>
          </p>

          <div class="series-strip">
            <SeriesStrip
              parts={seriesInfo.parts}
              current={seriesInfo.currentPart}
            />
          </div>

          <div class="series-steps">
            {seriesInfo.prev && <a
              href={`/posts/${seriesInfo.prev.slug}/`}
              class="series-step prev"
              rel="prev"
            >
              <span class="step-label">Previous part</span>
              <span class="step-title">{seriesInfo.prev.title}</span>
            </a>}
            {seriesInfo.next && <a
              href={`/posts/${seriesInfo.next.slug}/`}
              class="series-step next"
              rel="next"
            >
              <span class="step-label">Next part</span>
              <span class="step-title">{seriesInfo.next.title}</span>
            </a>}
          </div>

          <details class="series-all">
            <summary>All parts</summary>
            <ol class="series-list" role="list">
              {seriesInfo.parts.map((part) => <li>
                <span class="part-num">{part.partNumber}</span>
                {part.partNumber === seriesInfo.currentPart ? (
                  <span class="series-current" aria-current="page">
                    {part.title}
                  </span>
                ) : (
                  <a href={`/posts/${part.slug}/`}>{part.title}</a>
                )}
              </li>)}
            </ol>
          </details>
        </nav>}

        {!seriesInfo && (prevPost || nextPost) && <nav
          class="post-nav"
          aria-label="More posts"
        >
          {prevPost && <a
            href={`/posts/${prevPost.slug}/`}
            class="nav-link prev"
          >
            <span class="nav-label">Previous post</span>
            <span class="nav-title">{prevPost.title}</span>
          </a>}
          {nextPost && <a
            href={`/posts/${nextPost.slug}/`}
            class="nav-link next"
          >
            <span class="nav-label">Next post</span>
            <span class="nav-title">{nextPost.title}</span>
          </a>}
        </nav>}
      </footer>
    </article>
  </main>

  <script>
    import '../scripts/reading';
    import '../scripts/zoom';
  </script>

  <script>
    // Heading anchor links
    document
      .querySelectorAll(
        '.article-content h2[id], .article-content h3[id], .article-content h4[id]'
      )
      .forEach((heading) => {
        if (heading.querySelector('.heading-anchor')) return;
        const anchor = document.createElement('a');
        anchor.href = `#${heading.id}`;
        anchor.className = 'heading-anchor';
        anchor.setAttribute('aria-label', `Link to ${heading.textContent}`);
        anchor.textContent = '#';
        heading.appendChild(anchor);
      });

    // Code blocks: a small language label and a copy button. Plain text
    // blocks get only the button.
    const PLAIN = new Set(['', 'plaintext', 'text', 'txt']);
    document.querySelectorAll('.article-content pre').forEach((pre) => {
      if (pre.querySelector('.code-header')) return;
      const code = pre.querySelector('code');
      const lang =
        pre.getAttribute('data-language') ||
        code?.className.match(/language-(\w+)/)?.[1] ||
        '';

      const header = document.createElement('div');
      header.className = 'code-header';

      if (!PLAIN.has(lang)) {
        const langSpan = document.createElement('span');
        langSpan.className = 'code-lang';
        langSpan.textContent = lang;
        header.appendChild(langSpan);
      }

      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.textContent = 'Copy';
      btn.type = 'button';

      let resetTimer: ReturnType<typeof setTimeout> | undefined;
      btn.addEventListener('click', async () => {
        const text = code?.textContent || pre.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied';
          btn.classList.add('copied');
        } catch {
          btn.textContent = 'Copy failed';
        }
        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          btn.textContent = 'Copy';
          btn.classList.remove('copied');
        }, 2000);
      });

      header.appendChild(btn);
      pre.insertBefore(header, pre.firstChild);
    });

    // Copy link button: copies the canonical post URL, so a heading hash or
    // query string in the address bar doesn't end up in the shared link.
    const copyLinkBtn = document.getElementById('copy-link-btn');
    const copyLinkStatus = document.getElementById('copy-link-status');
    if (copyLinkBtn && copyLinkStatus) {
      let clearTimer: ReturnType<typeof setTimeout> | undefined;
      copyLinkBtn.addEventListener('click', async () => {
        const url = copyLinkBtn.dataset.url || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          copyLinkStatus.textContent = 'Copied';
        } catch {
          copyLinkStatus.textContent = 'Copy failed';
        }
        clearTimeout(clearTimer);
        clearTimer = setTimeout(() => {
          copyLinkStatus.textContent = '';
        }, 2000);
      });
    }
  </script>
</BaseLayout>

<style>
  .article {
    padding: 2.5rem 0 4rem;
  }

  /* ═══ Header ═══ */
  .article-header {
    margin-bottom: 2.5rem;
  }

  /* As wide as its words, like the list titles it morphs from. */
  h1 {
    width: fit-content;
    font-size: 2.125rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.2;
    color: var(--color-text);
    margin: 0 0 0.75rem;
  }

  /* The dek: what the post is about, a step down from the title. */
  .description {
    max-width: 40em;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    margin: 0;
  }

  /* One hairline-bordered row of small cells: the date and reading time
     in Plex Mono, then the series. */
  .facts {
    display: flex;
    margin: 1.75rem 0 0;
    border-block: 1px solid var(--color-border);
  }

  .fact {
    flex: 0 0 auto;
    min-width: 0;
    padding: 0.5rem 0.875rem 0.625rem;
  }

  .fact + .fact {
    border-left: 1px solid var(--color-border);
  }

  .fact:first-child {
    padding-left: 0;
  }

  .fact-wide {
    flex: 0 1 auto;
  }

  .facts dt {
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .facts dd {
    margin: 0.125rem 0 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .facts .fact-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .fact-link {
    white-space: nowrap;
    text-decoration-line: underline;
    text-decoration-color: var(--color-link-underline);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .fact-link:hover {
    text-decoration-color: currentColor;
  }

  .fact-part {
    display: block;
    color: var(--color-text-muted);
  }

  /* ═══ Series ═══ */
  /* At the end of a part: where it sits in its series, and the way on.
     Stays the same height however long the series gets: the full list
     waits behind a native <details>. */
  .series {
    margin-top: 2rem;
  }

  .series-title {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .series-title a {
    font-weight: 500;
  }

  .series-strip {
    margin-top: 0.5rem;
  }

  .series-steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 0.875rem;
  }

  .series-step {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-width: 0;
    text-decoration: none;
  }

  .series-step.next {
    grid-column: 2;
    text-align: right;
  }

  .step-label {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .step-title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-text);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .series-step:hover .step-title {
    text-decoration-line: underline;
  }

  .series-all {
    margin-top: 0.875rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-border-light);
  }

  .series-all summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    list-style: none;
    cursor: pointer;
  }

  .series-all summary::-webkit-details-marker {
    display: none;
  }

  /* Chevron: points right when closed, down when open. */
  .series-all summary::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }

  .series-all[open] summary::before {
    transform: translate(0, -0.125rem) rotate(45deg);
  }

  .series-all summary:hover {
    color: var(--color-text);
  }

  .series-list {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .series-list li {
    display: grid;
    grid-template-columns: 1.75rem 1fr;
    align-items: baseline;
    font-size: 0.9375rem;
    line-height: 1.45;
  }

  .part-num {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }

  .series-list a {
    color: var(--color-text-secondary);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
    text-decoration-line: none;
  }

  .series-list a:hover {
    color: var(--color-text);
    text-decoration-line: underline;
  }

  .series-current {
    color: var(--color-text);
    font-weight: 600;
  }

  .hero-image {
    margin-bottom: 2rem;
  }

  .hero-image img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
  }

  /* ═══ Article body ═══ */
  .article-content {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--color-text-body);
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    position: relative;
    color: var(--color-text);
    /* A little room above a heading that a link jumps to, under the
       running header (the page's scroll-padding, below). */
    scroll-margin-top: 1.5rem;
  }

  /* Jumps to an anchor stop below the running header. */
  :global(html) {
    scroll-padding-top: var(--runhead-height);
  }

  /* Long display math scrolls inside itself instead of widening the page.
     The padding keeps tall glyphs clear of the clipped edge. */
  .article-content :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding-block: 0.25em;
  }

  .article-content :global(h2) {
    font-size: 1.4375rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    margin: 3rem 0 0.875rem;
  }

  .article-content :global(h3) {
    font-size: 1.1875rem;
    font-weight: 600;
    line-height: 1.4;
    margin: 2.25rem 0 0.625rem;
  }

  .article-content :global(h4) {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.45;
    margin: 1.75rem 0 0.5rem;
  }

  .article-content :global(.heading-anchor) {
    margin-left: 0.375rem;
    font-weight: 400;
    color: var(--color-text-muted);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .article-content :global(h2:hover .heading-anchor),
  .article-content :global(h3:hover .heading-anchor),
  .article-content :global(h4:hover .heading-anchor),
  .article-content :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  @media (hover: none) {
    .article-content :global(.heading-anchor) {
      opacity: 1;
    }
  }

  .article-content :global(p) {
    margin: 0 0 1.25rem;
  }

  .article-content :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Links in the body use the shared .text-link look, and ==text== marks
     the shared mark look (both in BaseLayout). */

  /* ═══ Code ═══ */
  .article-content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    padding: 0.125em 0.375em;
    background: var(--color-surface);
    border: 1px solid var(--color-border-light);
    border-radius: 4px;
    color: var(--color-text);
  }

  /* Shiki writes the light theme's colors inline and the dark theme's into
     --shiki-dark variables. The block itself sits on the page's surface
     color in both themes instead of the theme's own background. */
  .article-content :global(pre) {
    position: relative;
    margin: 1.5rem 0;
    padding: 1rem;
    font-family: inherit;
    font-size: 0.875rem;
    line-height: 1.6;
    background: var(--color-surface) !important;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    overflow-x: auto;
  }

  .article-content :global(pre:has(.code-header)) {
    padding-top: 2.25rem;
  }

  .article-content :global(pre code) {
    font-size: inherit;
    padding: 0;
    background: none;
    border: none;
    border-radius: 0;
    color: inherit;
  }

  :global(.dark) .article-content :global(.astro-code),
  :global(.dark) .article-content :global(.astro-code code span) {
    color: var(--shiki-dark) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
    text-decoration: var(--shiki-dark-text-decoration) !important;
  }

  /* github-light-default's comment grey is 4.2:1 on the surface color; the
     muted text grey (4.9:1) keeps comments grey and readable. */
  :global(html:not(.dark))
    .article-content
    :global(.astro-code code span[style*='color:#6E7781' i]) {
    color: var(--color-text-muted) !important;
  }

  .article-content :global(.code-header) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.375rem 0.5rem 0 1rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .article-content :global(.code-lang) {
    color: var(--color-text-muted);
  }

  .article-content :global(.copy-btn) {
    margin-left: auto;
    padding: 0.125rem 0.5rem;
    font: inherit;
    color: var(--color-text-secondary);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 0.15s ease,
      color 0.15s ease;
  }

  .article-content :global(pre:hover .copy-btn),
  .article-content :global(.copy-btn:focus-visible),
  .article-content :global(.copy-btn.copied) {
    opacity: 1;
  }

  @media (hover: none) {
    .article-content :global(.copy-btn) {
      opacity: 1;
    }
  }

  .article-content :global(.copy-btn:hover) {
    color: var(--color-text);
  }

  .article-content :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 2px solid var(--color-text-faint);
    color: var(--color-text-secondary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.5rem;
  }

  .article-content :global(ul) {
    list-style: disc;
  }

  .article-content :global(ol) {
    list-style: decimal;
  }

  .article-content :global(ul ul) {
    list-style: circle;
  }

  .article-content :global(li) {
    margin: 0.375rem 0;
    padding-left: 0.125rem;
  }

  .article-content :global(li > ul),
  .article-content :global(li > ol) {
    margin: 0.375rem 0 0;
  }

  .article-content :global(li::marker) {
    color: var(--color-text-muted);
  }

  .article-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 4px;
    margin: 1.5rem 0;
  }

  /* Dark mode dims screenshots a little; hovering shows them as they are. */
  .article-content :global(img),
  .hero-image img {
    filter: var(--image-filter);
    transition: filter 0.2s ease;
  }

  .article-content :global(img:hover),
  .hero-image img:hover {
    filter: none;
  }

  /* ═══ Image zoom (scripts/zoom.ts) ═══ */
  /* Only images drawn smaller than their file get the zoom cursor. */
  .article-content :global(img.is-zoomable) {
    cursor: zoom-in;
  }

  .article-content :global(img.is-zoomable:focus-visible) {
    outline: 2px solid var(--color-text);
    outline-offset: 3px;
  }

  /* The dialog covers the window in the page color, so the image sits on
     the page rather than in a box; a click anywhere closes it. */
  :global(.zoom) {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 2rem;
    border: 0;
    color: var(--color-text);
    background: var(--color-bg);
    cursor: zoom-out;
  }

  :global(.zoom[open]) {
    display: grid;
    place-items: center;
  }

  :global(.zoom::backdrop) {
    background: transparent;
  }

  :global(html:has(.zoom[open])) {
    overflow: hidden;
  }

  @media (max-width: 639px) {
    :global(.zoom) {
      padding: 1rem;
    }
  }

  :global(.zoom-figure) {
    display: flex;
    flex-direction: column;
