---
import path from 'node:path';
import sharp from 'sharp';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import TableOfContents from '../components/TableOfContents.astro';
import { calculateReadingTime, ReadingTimeIcon } from '../utils/readingTime.js';
import type { SeriesInfo } from '../utils/seriesPosts';
import { hasMathContent } from '../utils/hasMath';
import { tagLabel, tagSlug } from '../utils/tags';

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
    pubDate: Date;
    updatedDate?: Date;
    heroImage?: string;
    tags?: string[];
    author?: string;
  };
  headings?: Array<{ depth: number; slug: string; text: string }>;
  prevPost?: { slug: string; title: string };
  nextPost?: { slug: string; title: string };
  relatedPosts?: Array<{ slug: string; title: string; description?: string }>;
  seriesInfo?: SeriesInfo | null;
  content?: string;
  slug?: string;
}

const {
  frontmatter,
  headings = [],
  prevPost,
  nextPost,
  relatedPosts = [],
  seriesInfo,
  content,
  slug: postSlug,
} = Astro.props;
const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  tags = [],
  author = 'Jongmin',
} = frontmatter;

const readingTime = calculateReadingTime(content || description || title);
const slug =
  postSlug ||
  Astro.url.pathname
    .split('/')
    .filter((p) => p)
    .pop() ||
  '';
// Always the generated 1200x630 PNG: hero images are WebP screenshots in
// arbitrary sizes, which some link previews reject or crop badly.
const ogImage = `/og/${slug}.png`;
const postUrl = new URL(`/posts/${slug}/`, Astro.site).toString();

// Real pixel size so the browser reserves the right box before the image loads.
// A missing local file fails the build on purpose; remote URLs aren't measured.
const heroSize = heroImage?.startsWith('/')
  ? await sharp(path.join(process.cwd(), 'public', heroImage)).metadata()
  : undefined;

// Detect math formulas ($ or $$ usage)
const hasMath = hasMathContent(content);

const formatDate = (date: Date) => {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);
};
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedTime={pubDate.toISOString()}
  modifiedTime={updatedDate?.toISOString()}
  tags={tags}
  author={author}
  image={ogImage}
  hasMath={hasMath}
  slug={slug}
>
  <div class="reading-progress" aria-hidden="true"></div>
  <Header />

  <TableOfContents headings={headings} />

  <main id="main-content">
    <article class="article">
      <header class="article-header">
        <div class="meta">
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span class="separator">·</span>
          <span class="reading-time">
            <Fragment set:html={ReadingTimeIcon} />
            {readingTime.text}
          </span>
        </div>

        <h1>{title}</h1>

        {description && <p class="description">{description}</p>}

        {
          tags.length > 0 && (
            <div class="tags">
              {tags.map((tag) => (
                <a href={`/tags/${tagSlug(tag)}/`} class="tag">
                  {tagLabel(tag)}
                </a>
              ))}
            </div>
          )
        }

        {
          seriesInfo && (
            <nav class="series-nav" aria-label="Series navigation">
              <p class="series-header">
                <a href={`/series/#${seriesInfo.id}`} class="series-name">
                  {seriesInfo.name}
                </a>
                <span class="series-count">
                  Part {seriesInfo.currentPart} of {seriesInfo.totalParts}
                </span>
              </p>

              <div class="series-steps">
                {seriesInfo.prev && (
                  <a
                    href={`/posts/${seriesInfo.prev.slug}/`}
                    class="series-step prev"
                    rel="prev"
                  >
                    <span class="step-label">
                      <span aria-hidden="true">←</span>
                      <span class="sr-only">Previous:</span>
                      Part {seriesInfo.prev.partNumber}
                    </span>
                    <span class="step-title">{seriesInfo.prev.title}</span>
                  </a>
                )}
                {seriesInfo.next && (
                  <a
                    href={`/posts/${seriesInfo.next.slug}/`}
                    class="series-step next"
                    rel="next"
                  >
                    <span class="step-label">
                      <span class="sr-only">Next:</span>
                      Part {seriesInfo.next.partNumber}
                      <span aria-hidden="true">→</span>
                    </span>
                    <span class="step-title">{seriesInfo.next.title}</span>
                  </a>
                )}
              </div>

              <details class="series-all">
                <summary>All parts</summary>
                <ol class="series-list" role="list">
                  {seriesInfo.parts.map((part) => (
                    <li>
                      <span class="part-num">{part.partNumber}</span>
                      {part.partNumber === seriesInfo.currentPart ? (
                        <span class="series-current" aria-current="page">
                          {part.title}
                        </span>
                      ) : (
                        <a href={`/posts/${part.slug}/`}>{part.title}</a>
                      )}
                    </li>
                  ))}
                </ol>
              </details>
            </nav>
          )
        }
      </header>

      {
        heroImage && (
          <div class="hero-image">
            <img
              src={heroImage}
              alt={title}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width={heroSize?.width}
              height={heroSize?.height}
            />
          </div>
        )
      }

      <TableOfContents headings={headings} variant="inline" />

      <div class="article-content">
        <slot />
      </div>

      <footer class="article-footer">
        <div class="share-buttons">
          <button
            class="share-btn"
            id="copy-link-btn"
            type="button"
            data-url={postUrl}
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
              ><path
                d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"
              ></path><path
                d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"
              ></path></svg
            >
            Copy link
          </button>
          <span class="share-status" id="copy-link-status" role="status"></span>
        </div>

        {
          relatedPosts.length > 0 && (
            <section class="related-posts">
              <h2 class="section-title">Related Posts</h2>
              <ul>
                {relatedPosts.map((post) => (
                  <li>
                    <a href={`/posts/${post.slug}/`}>
                      <span class="related-title">{post.title}</span>
                      {post.description && (
                        <span class="related-desc">{post.description}</span>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          (prevPost || nextPost) && (
            <nav class="post-nav" aria-label="Post navigation">
              <h2 class="section-title">Continue Reading</h2>
              {prevPost ? (
                <a href={`/posts/${prevPost.slug}/`} class="nav-link prev">
                  <span class="nav-label">Previous</span>
                  <span class="nav-title">{prevPost.title}</span>
                </a>
              ) : (
                <div />
              )}

              {nextPost && (
                <a href={`/posts/${nextPost.slug}/`} class="nav-link next">
                  <span class="nav-label">Next</span>
                  <span class="nav-title">{nextPost.title}</span>
                </a>
              )}
            </nav>
          )
        }

        <div class="author-bio">
          <div class="author-info">
            <span class="author-name">{author}</span>
            <span class="author-desc"
              >Writing about what I learn, think, and build.</span
            >
          </div>
        </div>
      </footer>
    </article>
  </main>

  <button
    class="back-to-top"
    id="back-to-top"
    aria-label="Back to top"
    type="button"
  >
    <svg
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
    >
      <path d="M18 15l-6-6-6 6"></path>
    </svg>
  </button>

  <script>
    // Reading progress bar
    const progressBar = document.querySelector(
      '.reading-progress'
    ) as HTMLElement;
    const article = document.querySelector('.article-content');

    if (progressBar && article) {
      const updateProgress = () => {
        const articleRect = article.getBoundingClientRect();
        const articleTop = articleRect.top + window.scrollY;
        const articleHeight = articleRect.height;
        const windowHeight = window.innerHeight;
        const scrollY = window.scrollY;

        const start = articleTop;
        const end = articleTop + articleHeight - windowHeight;
        const progress = Math.min(
          100,
          Math.max(0, ((scrollY - start) / (end - start)) * 100)
        );

        progressBar.style.width = `${progress}%`;
      };

      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    }

    // Heading anchor links
    document
      .querySelectorAll(
        '.article-content h2[id], .article-content h3[id], .article-content h4[id]'
      )
      .forEach((heading) => {
        if (heading.querySelector('.heading-anchor')) return;
        const anchor = document.createElement('a');
        anchor.href = `#${heading.id}`;
        anchor.className = 'heading-anchor';
        anchor.setAttribute('aria-label', `Link to ${heading.textContent}`);
        anchor.textContent = '#';
        heading.appendChild(anchor);
      });

    // Code block: language badge + copy button
    document.querySelectorAll('.article-content pre').forEach((pre) => {
      if (pre.querySelector('.code-header')) return;
      const code = pre.querySelector('code');
      const lang =
        pre.getAttribute('data-language') ||
        code?.className.match(/language-(\w+)/)?.[1] ||
        '';

      const header = document.createElement('div');
      header.className = 'code-header';

      const langSpan = document.createElement('span');
      langSpan.className = 'code-lang';
      langSpan.textContent = lang;
      header.appendChild(langSpan);

      const btn = document.createElement('button');
      btn.className = 'copy-btn';
      btn.textContent = 'Copy';
      btn.type = 'button';

      btn.addEventListener('click', async () => {
        const text = code?.textContent || pre.textContent || '';
        try {
          await navigator.clipboard.writeText(text);
          btn.textContent = 'Copied!';
          btn.classList.add('copied');
          setTimeout(() => {
            btn.textContent = 'Copy';
            btn.classList.remove('copied');
          }, 2000);
        } catch {
          btn.textContent = 'Failed';
          setTimeout(() => {
            btn.textContent = 'Copy';
          }, 2000);
        }
      });

      header.appendChild(btn);
      (pre as HTMLElement).style.position = 'relative';
      pre.insertBefore(header, pre.firstChild);
    });

    // Back to top button
    const backToTop = document.getElementById('back-to-top');
    if (backToTop) {
      const toggleBackToTop = () => {
        backToTop.classList.toggle('visible', window.scrollY > 400);
      };
      window.addEventListener('scroll', toggleBackToTop, { passive: true });
      backToTop.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    }

    // Copy link button: copies the canonical post URL, so a heading hash or
    // query string in the address bar doesn't end up in the shared link.
    const copyLinkBtn = document.getElementById('copy-link-btn');
    const copyLinkStatus = document.getElementById('copy-link-status');
    if (copyLinkBtn && copyLinkStatus) {
      let clearTimer: ReturnType<typeof setTimeout> | undefined;
      copyLinkBtn.addEventListener('click', async () => {
        const url = copyLinkBtn.dataset.url || window.location.href;
        try {
          await navigator.clipboard.writeText(url);
          copyLinkStatus.textContent = 'Copied';
        } catch {
          copyLinkStatus.textContent = 'Copy failed';
        }
        clearTimeout(clearTimer);
        clearTimer = setTimeout(() => {
          copyLinkStatus.textContent = '';
        }, 2000);
      });
    }
  </script>
</BaseLayout>

<style>
  .article {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .article-header {
    margin-bottom: 2rem;
  }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }

  .separator {
    color: var(--color-border);
  }

  .reading-time {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .reading-time :global(svg) {
    width: 14px;
    height: 14px;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: clamp(1.875rem, 4.5vw, 2.625rem);
    font-weight: 500;
    /* The 144 poster cut sets letters too close at this size; 72 keeps the
       display contrast with open spacing. */
    font-variation-settings: 'opsz' 72;
    letter-spacing: -0.015em;
    color: var(--color-text);
    line-height: 1.15;
    margin: 0 0 1.25rem;
  }

  .description {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-style: italic;
    font-weight: 400;
    color: var(--color-text-secondary);
    line-height: 1.55;
    margin: 0 0 1.5rem;
    max-width: 54ch;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.875rem;
    row-gap: 0.25rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    line-height: 1.5;
    transition: color 0.15s ease;
  }

  /* The "#" is drawn, with empty alt text so screen readers skip it. */
  .tag::before {
    content: '#';
    content: '#' / '';
    margin-right: -0.15em;
  }

  .tag:hover {
    color: var(--color-accent);
  }

  /* Series: a compact block that stays the same height however long the
     series gets. The full list waits behind a native <details>. */
  .series-nav {
    margin-top: 1.75rem;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .series-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.875rem 0 0.75rem;
  }

  .series-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .series-name:hover {
    color: var(--color-accent);
  }

  .series-count {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .series-steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem 2rem;
    padding-bottom: 0.875rem;
  }

  .series-step {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    text-decoration: none;
  }

  .series-step.next {
    grid-column: 2;
    align-items: flex-end;
    text-align: right;
  }

  .step-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .step-title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--color-text);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.15s ease;
  }

  .series-step:hover .step-title {
    color: var(--color-accent);
  }

  .series-all {
    border-top: 1px solid var(--color-border-light);
  }

  .series-all summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.75rem 0;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    list-style: none;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .series-all summary::-webkit-details-marker {
    display: none;
  }

  /* Chevron: points right when closed, down when open. */
  .series-all summary::before {
    content: '';
    width: 0.375rem;
    height: 0.375rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(-45deg);
    transition: transform 0.2s ease;
  }

  .series-all[open] summary::before {
    transform: translate(0, -0.125rem) rotate(45deg);
  }

  .series-all summary:hover {
    color: var(--color-accent);
  }

  .series-list {
    list-style: none;
    margin: 0;
    padding: 0 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .series-list li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: baseline;
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .part-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  .series-list a {
    color: var(--color-text-subtle);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .series-list a:hover {
    color: var(--color-accent);
  }

  .series-current {
    color: var(--color-accent);
    font-weight: 600;
  }

  .hero-image {
    margin-bottom: 2rem;
    border-radius: 8px;
    overflow: hidden;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  .article-content {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: var(--color-text-body);
  }

  .article-content :global(h2),
  .article-content :global(h3),
  .article-content :global(h4) {
    position: relative;
    /* Clears the sticky header when a link jumps to the heading. */
    scroll-margin-top: 5rem;
  }

  .article-content :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.625rem;
    font-weight: 600;
    font-variation-settings: 'opsz' 36;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-text);
    margin: 3.25rem 0 1rem;
  }

  .article-content :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-text);
    margin: 2.25rem 0 0.75rem;
  }

  .article-content :global(.heading-anchor) {
    margin-left: 0.375rem;
    font-size: 0.85em;
    font-weight: 400;
    color: var(--color-text-faint);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.15s;
  }

  .article-content :global(h2:hover .heading-anchor),
  .article-content :global(h3:hover .heading-anchor),
  .article-content :global(h4:hover .heading-anchor),
  .article-content :global(.heading-anchor:focus) {
    opacity: 1;
  }

  .article-content :global(.heading-anchor:hover) {
    color: var(--color-accent);
  }

  @media (hover: none) {
    .article-content :global(.heading-anchor) {
      opacity: 1;
    }
  }

  .article-content :global(p) {
    margin: 0 0 1.5rem;
  }

  .article-content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .article-content :global(code) {
    font-family:
      'SF Mono', 'Fira Code', 'JetBrains Mono', Menlo, Monaco, Consolas,
      monospace;
    font-size: 0.875em;
    padding: 0.2em 0.5em;
    background: var(--color-code-inline-bg);
    border: 1px solid var(--color-code-inline-border);
    border-radius: 6px;
    color: var(--color-code-inline-text);
    font-weight: 500;
  }

  .article-content :global(pre) {
    position: relative;
    padding: 1rem;
    background: var(--color-code-bg) !important;
    border: 1px solid var(--color-code-border);
    border-radius: 6px;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .article-content :global(pre code) {
    padding: 0;
    background: transparent !important;
    border: none;
    font-size: 0.875rem;
    color: var(--color-code-text);
    font-weight: 400;
    line-height: 1.45;
  }

  /* Reset Shiki line backgrounds */
  .article-content :global(pre code .line),
  .article-content :global(pre code span) {
    background: transparent !important;
  }

  .article-content :global(.code-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    padding: 0.375rem 0.75rem;
    background: var(--color-code-header-bg);
    border-bottom: 1px solid var(--color-code-border);
    border-radius: 6px 6px 0 0;
  }

  .article-content :global(.code-lang) {
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--color-code-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .article-content :global(.copy-btn) {
    padding: 0.125rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--color-code-muted);
    background: transparent;
    border: 1px solid var(--color-code-border);
    border-radius: 4px;
    cursor: pointer;
    opacity: 0;
    transition: all 0.15s ease;
  }

  .article-content :global(pre:hover .copy-btn) {
    opacity: 1;
  }

  @media (hover: none) {
    .article-content :global(.copy-btn) {
      opacity: 1;
    }
  }

  .article-content :global(.copy-btn:hover) {
    background: var(--color-code-border);
    color: var(--color-code-text);
  }

  .article-content :global(.copy-btn.copied) {
    color: var(--color-code-success);
    border-color: var(--color-code-success);
  }

  .article-content :global(pre:has(.code-header)) {
    padding-top: 2.5rem;
  }

  .article-content :global(blockquote) {
    margin: 1.5rem 0;
    padding: 0.5rem 1rem;
    border-left: 3px solid var(--color-accent);
    background: var(--color-surface);
    color: var(--color-text-soft);
  }

  :global(.dark) .article-content :global(blockquote) {
    color: var(--color-text-secondary);
  }

  .article-content :global(ul),
  .article-content :global(ol) {
    margin: 1rem 0 1.5rem;
    padding-left: 1.5rem;
    list-style-position: outside;
  }

  .article-content :global(ul) {
    list-style: disc;
  }

  .article-content :global(ol) {
    list-style: decimal;
  }

