{
  "name": "jongmin-blog",
  "type": "module",
  "version": "2.0.0",
  "description": "Jongmin's personal dev blog built with Astro",
  "author": "Jongmin",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.{astro,ts,js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,js,mjs}\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/markdown-satteri": "^0.3.5",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.2.2",
    "fuse.js": "^7.1.0",
    "katex": "^0.16.27",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.29.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@typescript-eslint/parser": "^8.55.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^1.5.0",
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
